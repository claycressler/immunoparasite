results001 <- readRDS("results_efficient_vs_resistant_extinct_rate=0.001_9-8.RDS")
results005 <- readRDS("results_efficient_vs_resistant_extinct_rate=0.005_9-8.RDS")
results01 <- readRDS("results_efficient_vs_resistant_extinct_rate=0.01_9-8.RDS")
results001 %<>% mutate(.,
e_rate="Low extinction rate",
ratio=meanS1/meanS2,
prev=meanS1/(meanS1+meanS2))
## Only ran the low extinction rate up to mortality coefficient of 5 because it was so slow.
## But there were no cases where emergence was prevented, even for low mortality coefficients, so there is no chance that emergence would *ever* be prevented.
results001 = expand.grid(rep=1:20, yield_coef=1:20, mort_coef=1:20) %>%
mutate(tFinal=0,
P1=0,
P2=0,
meanS1=0,
meanS2=0,
e_rate = "Low extinction rate",
ratio = Inf,
prev = 1.0)
results005 %<>% mutate(.,
e_rate="Moderate extinction rate",
ratio=meanS1/meanS2,
prev=meanS1/(meanS1+meanS2))
results01 %<>% mutate(.,
e_rate = "High extinction rate",
ratio=meanS1/meanS2,
prev=meanS1/(meanS1+meanS2))
overall = rbind(results001, rbind(results005, results01))
overall$e_rate = factor(overall$e_rate, levels=c("Low extinction rate", "Moderate extinction rate", "High extinction rate"))
overall %>%
ggplot(., aes(x=yield_coef, y=mort_coef, color=prev)) +
geom_jitter(alpha=0.5) +
facet_wrap(~e_rate, nrow=3) +
scale_color_viridis_c(direction=-1) +
theme_bw()
# Internal knots and boundary
int_knots <- seq(0.1, 0.9, by = 0.1)      # 0.1, ..., 0.9
bknots    <- c(0, 1)
# A helper to build the basis matrix for any x in [0,1]
bs_basis <- function(x) {
bs(x,
degree         = 3,               # cubic
knots          = int_knots,
Boundary.knots = bknots,
intercept      = TRUE)            # include the full set of basis functions
}
# Factory to turn a coefficient vector into a function f(x)
make_spline_function <- function(beta) {
force(beta)
function(x) {
Bx <- bs_basis(x)
drop(Bx %*% beta)  # vectorized over x
}
}
set.seed(123)
n_splines <- 1000
# Option A: plain Gaussian coefficients
coef_list <- replicate(n_splines, rnorm(p, mean = 0, sd = 1), simplify = FALSE)
# Build the list of 1000 spline functions
spline_fns <- lapply(coef_list, make_spline_function)
# Option A: plain Gaussian coefficients
coef_list <- replicate(n_splines, rnorm(p, mean = 0, sd = 1), simplify = FALSE)
# Option A: plain Gaussian coefficients
coef_list <- replicate(n_splines, rnorm(13, mean = 0, sd = 1), simplify = FALSE)
# Get the basis dimension p
p <- ncol(bs_basis(seq(0, 1, length.out = 5)))  # returns 13
# Load base splines
library(splines)
# Internal knots and boundary
int_knots <- seq(0.1, 0.9, by = 0.1)      # 0.1, ..., 0.9
bknots    <- c(0, 1)
# A helper to build the basis matrix for any x in [0,1]
bs_basis <- function(x) {
bs(x,
degree         = 3,               # cubic
knots          = int_knots,
Boundary.knots = bknots,
intercept      = TRUE)            # include the full set of basis functions
}
# Factory to turn a coefficient vector into a function f(x)
make_spline_function <- function(beta) {
force(beta)
function(x) {
Bx <- bs_basis(x)
drop(Bx %*% beta)  # vectorized over x
}
}
set.seed(123)
n_splines <- 1000
# Get the basis dimension p
p <- ncol(bs_basis(seq(0, 1, length.out = 5)))  # returns 13
# Option A: plain Gaussian coefficients
coef_list <- replicate(n_splines, rnorm(p, mean = 0, sd = 1), simplify = FALSE)
# Build the list of 1000 spline functions
spline_fns <- lapply(coef_list, make_spline_function)
spline_fns
spline_fns[[1]]
spline_fns[[1]](0)
coef_list[[1]]
coef_list[[2]]
# Factory to turn a coefficient vector into a function f(x)
make_spline_function <- function(beta) {
force(beta)
function(x) {
Bx <- bs_basis(x)
plogis(drop(Bx %*% beta))  # logistic maps R -> (0,1)
}
}
# Build the list of 1000 spline functions
spline_fns <- lapply(coef_list, make_spline_function)
spline_fns[[1]]
spline_fns[[1]](seq(0,1,0.1))
# Internal knots and boundary
int_knots <- seq(5,360,5)      # 0.1, ..., 0.9
bknots    <- c(0, 365)
# A helper to build the basis matrix for any x in [0,1]
bs_basis <- function(x) {
bs(x,
degree         = 3,               # cubic
knots          = int_knots,
Boundary.knots = bknots,
intercept      = TRUE)            # include the full set of basis functions
}
# Factory to turn a coefficient vector into a function f(x)
make_spline_function <- function(beta) {
force(beta)
function(x) {
Bx <- bs_basis(x)
plogis(drop(Bx %*% beta))  # logistic maps R -> (0,1)
}
}
set.seed(123)
n_splines <- 1000
# Get the basis dimension p
p <- ncol(bs_basis(seq(0, 1, length.out = 5)))  # returns 13
p
# The basis dimension p is equal to the degree (3) + the number of internal knots + 1
p <- 3 + length(int_knots) + 1
p
# With Gaussian coefficients
coef_list <- replicate(n_splines, rnorm(p, mean = 0, sd = 1), simplify = FALSE)
# Build the list of 1000 spline functions
spline_fns <- lapply(coef_list, make_spline_function)
spline_fns[[1]]
spline_fns[[1]](seq(0,365))
spline_fns[[1]](seq(0,365)) %>% plot(0)
plot(spline_fns[[1]](seq(0,365)))
