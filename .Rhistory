find_Sequal = function(yield_coef, mort_coef) {
x = calc_rel_equil_2(mort_coef, yield_coef)
return(abs(x["S1"]-x["S2"]))
}
optimize(find_Sequal, interval=c(0, 20), mort_coef=1)
optimize(find_Sequal, interval=c(0, 20), mort_coef=2)
optimize(find_Sequal, interval=c(0, 20), mort_coef=3)
optimize(find_Sequal, interval=c(0, 20), mort_coef=1)
data.frame(mort_coef=seq(1,20,0.05),
eff_coef=sapply(seq(1,20,0.05),
function(m) optimize(find_Sequal, interval=c(0, 20), mort_coef=m)$minimum)
) -> Sequal2
Sequal2
rel_equil2
ggplot(rel_equil2, aes(x=eff_coef, y=mort_coef, color=Sratio)) +
geom_point() +
scale_color_viridis_c(direction=-1) +
geom_line(mapping=aes(x=eff_coef, y=mort_coef, color=NA), data=Sequal2) +
labs(x="Strain 2 Relative Efficiency",
y="Mortality coefficient",
color="S1/S2") -> plot4
plot4
