}
}
duration_data[[j]] = do.call("rbind.data.frame", infection_data)
## Average infection duration for infections that started in different blocks of time and resolved (either clearance or death)
sapply(seq(1, 351, 50), function(t) filter(duration_data[[j]], starts >= t, starts <= t+50, censored==0)$durations %>% mean()) -> mean_duration_vectors[[j]]
## Average case fatality rate for infections that started in different blocks of time and resolved (either clearance or death)
sapply(seq(1, 351, 50), function(t) sum(filter(duration_data[[j]], starts >= t, starts <= t+50, censored==0)$died)/length(filter(duration_data[[j]], starts >= t, starts <= t+50, censored==0)$died)) -> case_fatality_vectors[[j]]
}
saveRDS(mean_duration_vectors, paste0("Mean_duration_vectors_min_Th2=",th2,"_3-25.RDS"))
saveRDS(case_fatality_vectors, paste0("Case_fatality_vectors_min_Th2=",th2,"_3-25.RDS"))
}
case_fatality_vectors = readRDS(paste0("Case_fatality_vectors_min_Th2=",th2,"_3-25.RDS"))
plot.new()
plot.window(xlim=c(0,400), ylim=c(0,1))
axis(1); axis(2); box('plot')
for (i in 1:50) {
lines(seq(26,376,50), case_fatality_vectors[[i]], col='gray')
}
do.call("rbind.data.frame", case_fatality_vectors) %>% apply(., 2, function(x) median(x,na.rm=T)) %>% lines(seq(26,376,50),., lwd=2)
mtext(side=1, line=2.5, "Time")
mtext(side=2, line=2.5, "Case fatality rate")
legend(x='topleft', legend=paste0("Init Th2=",th2,"-",800), bty='n', text.col='blue')
