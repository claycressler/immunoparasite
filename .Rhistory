## Average case fatality rate for infections that started in different blocks of time and resolved (either clearance or death)
sapply(seq(1, 351, 50), function(t) sum(filter(duration_data[[j]], starts >= t, starts <= t+50, censored==0)$clearance)/length(filter(duration_data[[j]], starts >= t, starts <= t+50, censored==0)$clearance)) -> case_fatality_vectors[[j]]
}
