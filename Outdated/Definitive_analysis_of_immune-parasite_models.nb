   RowBox[{"-", "\[Nu]"}], ",", 
   RowBox[{"\[Lambda]", "-", 
    FractionBox[
     RowBox[{"\[Gamma]", " ", 
      RowBox[{
       SuperscriptBox["\[Kappa]", "\[Prime]",
        MultilineFunction->None], "[", "0", "]"}]}], "\[Nu]"]}]}], 
