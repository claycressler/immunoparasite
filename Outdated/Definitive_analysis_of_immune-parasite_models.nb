  3.7972492789674473`*^9, 3.797249283500963*^9}, {3.7972493900493*^9, 
  3.797249453029727*^9}, {3.797260812208549*^9, 3.797260816887411*^9}, {
  3.797261762070017*^9, 3.79726176906714*^9}, {3.797261811795223*^9, 
  3.7972618180161877`*^9}, {3.797262266116152*^9, 
  3.797262266431197*^9}},ExpressionUUID->"97a75f13-7e85-4913-a5da-\
3016f446bc0a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"th1isocline", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"dth1", "\[Equal]", "0"}], ",", "th2"}], "]"}], 
    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"th2isocline", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"dth2", "\[Equal]", "0"}], ",", "th1"}], "]"}], 
    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.796751461652462*^9, 3.796751462216481*^9}, {
  3.797261771251163*^9, 3.797261803813122*^9}, {3.797261836142343*^9, 
  3.797261841304134*^9}, {3.7973335821155357`*^9, 3.7973336376093063`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"e2fed94f-cbf1-45b5-a4c5-c5681db97ddc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"th2", "\[Rule]", 
   FractionBox[
    RowBox[{"\[Iota]12", " ", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["th1", "2"], "-", "\[Beta]1", "-", 
       RowBox[{"th1", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Beta]1", "+", "\[Sigma]1"}], 
         ")"}]}]}]]}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", "th1"}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"th1", "-", "\[Beta]1"}], ")"}]}]]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.796751458708185*^9, 3.797259966933689*^9, 3.797260767559523*^9, {
   3.797261773641905*^9, 3.797261804884213*^9}, {3.797261837644732*^9, 
   3.7972618415485888`*^9}, 3.797265800301203*^9, {3.79733357814089*^9, 
