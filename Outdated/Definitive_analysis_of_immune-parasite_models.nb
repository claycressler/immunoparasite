Cell[TextData[{
 "However, it must be the case that the Th abundance is below a critical \
value for the numerator to be real, and above ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "4a79cde9-1556-4ac4-8d49-a5ca5e7c37ae"],
 " for the denominator to be real. In particular, if th1 > ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d6fa3e7c-2453-48a3-b2ce-fd4706ef937d"],
 ", then the numerator and denominator will both be positive real numbers, \
and the isocline will exist. Basically, this model has a limited portion of \
state space where the isoclines will exist."
}], "Text",
 CellChangeTimes->{{3.79726227064957*^9, 3.797262327709981*^9}, {
  3.797263797235393*^9, 3.797263871079999*^9}, {3.797263902547443*^9, 
  3.7972639034579067`*^9}},ExpressionUUID->"65c34369-9547-4fa1-a5c5-\
2eaba5ddf55b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "value", " ", "of", " ", "the", " ", "numerator", " ", "if", 
     " ", "th1"}], " ", "=", " ", "\[Beta]1"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
