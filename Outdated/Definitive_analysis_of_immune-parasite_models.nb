Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Here", " ", "are", " ", "the", " ", "equilibria"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"equil", "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"dp", "\[Equal]", "0"}], ",", "p"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "\[Rule]", "0.5"}], ",", 
       RowBox[{"K", "\[Rule]", "100"}], ",", 
       RowBox[{"a", "\[Rule]", "0.1"}], ",", 
       RowBox[{"Th", "\[Rule]", "2"}], ",", 
       RowBox[{"t", "\[Rule]", "20"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"The", " ", "middle", " ", "two", " ", "are", " ", "stable"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"dp", ",", "p"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "\[Rule]", "0.5"}], ",", 
       RowBox[{"K", "\[Rule]", "100"}], ",", 
       RowBox[{"a", "\[Rule]", "0.1"}], ",", 
       RowBox[{"Th", "\[Rule]", "2"}], ",", 
       RowBox[{"t", "\[Rule]", "20"}]}], "}"}]}], "/.", 
    "equil"}]}]}]], "Input",
 CellChangeTimes->{
  3.796071263077124*^9, {3.7960713445848913`*^9, 3.796071347788865*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"077abb0f-148c-460e-8b25-b3634344811b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"p", "\[Rule]", 
     RowBox[{"0.2525496379110841`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.`", " ", "\[ImaginaryI]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"p", "\[Rule]", 
     RowBox[{"72.4032534918158`", "\[VeryThinSpace]", "-", 
      RowBox[{"3.552713678800501`*^-15", " ", "\[ImaginaryI]"}]}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"p", "\[Rule]", 
     RowBox[{"27.344196870273116`", "\[VeryThinSpace]", "+", 
      RowBox[{"3.552713678800501`*^-15", " ", "\[ImaginaryI]"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.7960712636804028`*^9, 3.7960713481523533`*^9},
 CellLabel->
  "Out[175]=",ExpressionUUID->"18ae210d-4af2-434e-8a7c-1de250e5056e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.5`", ",", 
   RowBox[{
    RowBox[{"-", "0.487436218884298`"}], "+", 
    RowBox[{"0.`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{
    RowBox[{"-", "0.22429549976473184`"}], "+", 
    RowBox[{"3.54884761559976`*^-17", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.22173171864904084`", "\[VeryThinSpace]", "-", 
    RowBox[{"3.36626123261856`*^-17", " ", "\[ImaginaryI]"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.7960712636804028`*^9, 3.796071348155109*^9},
 CellLabel->
  "Out[176]=",ExpressionUUID->"544728cb-ddc0-469e-843b-5adaaec3041d"]
}, Open  ]],

Cell["\<\
But if you add in a dynamic immune response, I\[CloseCurlyQuote]m pretty sure \
this will go away, as I know that it will for the case with a Type II \
functional response. 

I can do a little digging to ensure this. To stay more consistent with the \
parasite-mediated feedback model, I will continue to assume logistic growth \
of the parasite and see if a Type III functional response is sufficient.\
\>", "Text",
 CellChangeTimes->{{3.7960675182378273`*^9, 3.79606752219496*^9}, {
  3.796068099053206*^9, 3.796068105889441*^9}, {3.796071414039921*^9, 
  3.796071443065012*^9}},ExpressionUUID->"56aa018d-644f-414c-929c-\
91d53d2042c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dt", "=", 
   RowBox[{"\[Gamma]", "+", 
    RowBox[{"\[Epsilon]", " ", 
     RowBox[{"\[Kappa]", "[", "p", "]"}], " ", "t"}], "-", 
    RowBox[{"\[Nu]", " ", "t"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dp", "=", 
   RowBox[{
    RowBox[{"\[Lambda]", " ", "p", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"\[Kappa]", "[", "p", "]"}], " ", "t"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.7960574357409697`*^9, 3.7960574613462477`*^9}, {
  3.796058688489624*^9, 3.796058689128207*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"53ac9094-091c-4df6-8cdf-16449c4218e4"],

Cell[TextData[{
 "What is required for there to be bistability between a disease-free \
equilibrium and a disease present equilibrium?\n\nStability of the acute \
infection equilibrium requires that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[Lambda]", "-", 
    FractionBox[
     RowBox[{"\[Gamma]", " ", 
      RowBox[{
       SuperscriptBox["\[Kappa]", "\[Prime]",
        MultilineFunction->None], "[", "0", "]"}]}], "\[Nu]"]}], "<", "0"}]],
  CellChangeTimes->{{3.796057575176207*^9, 3.796057579531104*^9}, 
    3.796057734686057*^9},ExpressionUUID->
  "e60deda5-f9c9-44a4-89d7-6042236cb1eb"],
 ". Note that this somewhat restricts the possible functional forms for the \
immune system\[CloseCurlyQuote]s functional response for bistability to be \
possible. In particular, any function that has a slope of 0 at ",
 StyleBox["p",
  FontSlant->"Italic"],
 " = 0 (which includes a Type III functional response) can never be bistable \
between an acute and chronic infection. A Type II functional response, \
however, would work. "
}], "Text",
 CellChangeTimes->{{3.796057466298746*^9, 3.796057485578002*^9}, {
  3.796057709915696*^9, 3.7960577415618677`*^9}, {3.796057833327976*^9, 
  3.796057994585631*^9}, {3.796058232557816*^9, 3.7960582397008953`*^9}, {
  3.796058425833585*^9, 3.7960584385791683`*^9}, {3.7960585536781588`*^9, 
  3.796058632338035*^9}},ExpressionUUID->"de4e2e39-d63b-4c26-bc7b-\
a0dcc83dba7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"acuteEquil", "=", 
  RowBox[{"Append", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dt", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Kappa]", "[", "p", "]"}], "\[Rule]", "0"}], "}"}]}], 
         ")"}], "\[Equal]", "0"}], ",", "t"}], "]"}], "\[LeftDoubleBracket]", 
     "1", "\[RightDoubleBracket]"}], ",", 
    RowBox[{"p", "\[Rule]", "0"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"J", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dt", ",", "dp"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"t", ",", "p"}], "}"}], "}"}]}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Eigenvalues", "[", 
   RowBox[{
    RowBox[{"J", "/.", "acuteEquil"}], "/.", 
    RowBox[{
     RowBox[{"\[Kappa]", "[", "0", "]"}], "\[Rule]", "0"}]}], "]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.7960574950966997`*^9, 3.796057579212562*^9}, {
  3.796057729278926*^9, 3.796057734082706*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"44dadb3f-e24e-42d4-87db-69f88f7a3a0b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"t", "\[Rule]", 
    FractionBox["\[Gamma]", "\[Nu]"]}], ",", 
   RowBox[{"p", "\[Rule]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.796057575176207*^9, 3.796057579531104*^9}, 
   3.796057734680938*^9, 3.796058693224922*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"37298c40-88be-49e3-a5bf-fdb67a2c686b"],

