Cell[CellGroupData[{

Cell["What about a model where inhibition is stronger?", "Subsubsection",
 CellChangeTimes->{{3.796731557885154*^9, 3.796731559763797*^9}, {
  3.797248224985718*^9, 3.797248227201269*^9}, {3.797259545264304*^9, 
  3.797259552384625*^9}, {3.797260523622098*^9, 
  3.7972605305630827`*^9}},ExpressionUUID->"faa0a145-9763-41e6-ad7a-\
9b862d938b22"],

Cell["\<\
In this model, there is very strong inhibition between Th cell populations, \
but smooth self-promotion.\
\>", "Text",
 CellChangeTimes->{{3.7972482314423923`*^9, 3.797248304297756*^9}, {
  3.7972483472619953`*^9, 3.797248432401791*^9}, {3.79724887715899*^9, 
  3.797248991280682*^9}, {3.797259557042265*^9, 3.797259616498551*^9}, {
  3.7972605652468452`*^9, 
  3.7972606007856283`*^9}},ExpressionUUID->"9e3a6428-ea7e-4f52-8780-\
6b29e01e2498"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dTh1", "=", 
   RowBox[{"b1", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s1", " ", "Th1"}], 
      RowBox[{"S1", "+", "Th1"}]], " ", 
     FractionBox[
      SuperscriptBox["I12", "2"], 
      RowBox[{
       SuperscriptBox["I12", "2"], "+", 
       SuperscriptBox["Th2", "2"]}]]}], " ", "-", 
    RowBox[{"m", " ", "Th1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dTh2", "=", 
   RowBox[{"b2", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s2", " ", "Th2"}], 
      RowBox[{"S2", "+", "Th2"}]], " ", 
     FractionBox[
      SuperscriptBox["I21", "2"], 
      RowBox[{
       SuperscriptBox["I21", "2"], "+", 
       SuperscriptBox["Th1", "2"]}]]}], "-", 
    RowBox[{"m", " ", "Th2"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.796731586071199*^9, 3.796731630200124*^9}, {
   3.796741122839666*^9, 3.796741132927824*^9}, {3.796743393254848*^9, 
   3.796743396792616*^9}, {3.796743653283901*^9, 3.7967437158052197`*^9}, {
   3.796743756847563*^9, 3.796743860610216*^9}, {3.796743942015568*^9, 
   3.7967439537154293`*^9}, {3.796743996586073*^9, 3.796744008699789*^9}, {
   3.796744045556903*^9, 3.796744196261994*^9}, 3.796745669104089*^9, {
   3.7972489955375443`*^9, 3.797248997266801*^9}, {3.7972595831340733`*^9, 
   3.797259587295039*^9}, {3.7972596195701227`*^9, 3.797259625320241*^9}, {
   3.797260551467358*^9, 3.797260561816023*^9}, {3.7972606036324873`*^9, 
   3.797260610427145*^9}, {3.797332950922583*^9, 3.797332953574561*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"6cbcd54f-9d1b-4b1c-851e-7f74a8a8774a"],

Cell["\<\
This model can be nondimensionalized similarly to previous models:\
\>", "Text",
 CellChangeTimes->{{3.797248999245418*^9, 3.7972490112945347`*^9}, {
  3.7972597581591*^9, 3.797259758519046*^9}, {3.797259929531125*^9, 
  3.797259942422817*^9}, {3.797260713849072*^9, 
  3.797260717617175*^9}},ExpressionUUID->"004a32e1-79c3-44f2-b54f-\
66931d54008e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"dth1", "=", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["that", "TH1hat"], 
         RowBox[{"(", 
          RowBox[{"dTh1", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Th1", "\[Rule]", 
              RowBox[{"TH1hat", " ", "th1"}]}], ",", 
             RowBox[{"Th2", "\[Rule]", 
              RowBox[{"TH2hat", " ", "th2"}]}]}], "}"}]}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TH1hat", "\[Rule]", "S1"}], ",", 
          RowBox[{"TH2hat", "\[Rule]", "S2"}], ",", 
          RowBox[{"that", "\[Rule]", 
           RowBox[{"1", "/", "m"}]}]}], "}"}]}], "/.", 
       RowBox[{"b1", "\[Rule]", 
        RowBox[{"\[Beta]1", " ", "m", " ", "S1"}]}]}], "/.", 
      RowBox[{"s1", "\[Rule]", 
       RowBox[{"\[Sigma]1", " ", "m", " ", "S1"}]}]}], "/.", 
     RowBox[{"I12", "\[Rule]", 
      RowBox[{"\[Iota]12", " ", "S2"}]}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"dth2", "=", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["that", "TH2hat"], 
         RowBox[{"(", 
          RowBox[{"dTh2", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Th1", "\[Rule]", 
              RowBox[{"TH1hat", " ", "th1"}]}], ",", 
             RowBox[{"Th2", "\[Rule]", 
              RowBox[{"TH2hat", " ", "th2"}]}]}], "}"}]}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TH1hat", "\[Rule]", "S1"}], ",", 
          RowBox[{"TH2hat", "\[Rule]", "S2"}], ",", 
          RowBox[{"that", "\[Rule]", 
           RowBox[{"1", "/", "m"}]}]}], "}"}]}], "/.", 
       RowBox[{"b2", "\[Rule]", 
        RowBox[{"\[Beta]2", " ", "m", " ", "S2"}]}]}], "/.", 
      RowBox[{"s2", "\[Rule]", 
       RowBox[{"\[Sigma]2", " ", "m", " ", "S2"}]}]}], "/.", 
     RowBox[{"I21", "\[Rule]", 
      RowBox[{"\[Iota]21", " ", "S1"}]}]}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{
  3.7972606286331987`*^9, {3.797260672500209*^9, 3.797260742907977*^9}, {
   3.797332961848401*^9, 3.797332978966894*^9}, {3.797333128087796*^9, 
   3.797333135037745*^9}, {3.797333712942382*^9, 3.797333723380644*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"304a2a9e-cec8-4946-a140-7d7f5feef6a0"],

Cell[BoxData[
 RowBox[{"\[Beta]1", "+", 
  RowBox[{"th1", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Iota]12", "2"], " ", "\[Sigma]1"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "th1"}], ")"}], " ", 
       RowBox[{"(", 
