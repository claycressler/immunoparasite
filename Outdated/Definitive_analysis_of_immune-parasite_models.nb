         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "stable", " ", "equilibria", " ", "have", " ", "a", " ", "positive", " ", 
    "determinant", " ", "and", " ", "a", " ", "negative", " ", "trace"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realEq", "=", 
   RowBox[{"eq", "\[LeftDoubleBracket]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}]}], 
      "]"}], "]"}], "\[RightDoubleBracket]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableInds", "=", 
