Cell[TextData[{
 "On the other hand, if you weaken cross-inhibition by reducing the value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Iota]", "ij"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "489b2831-9b81-4e7e-bf3d-6cb5544d9e33"],
 ", you end up with a single stable equilibrium representing a low \
co-expression equilibrium."
}], "Text",
 CellChangeTimes->{{3.797265257263336*^9, 
  3.797265305999518*^9}},ExpressionUUID->"1e4a8f05-bc45-41c4-bb89-\
0d6a54482735"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Sigma]1", "\[Rule]", "20"}], ",", 
     RowBox[{"\[Sigma]2", "\[Rule]", "20"}], ",", 
     RowBox[{"\[Beta]1", "\[Rule]", "0.1`"}], ",", 
     RowBox[{"\[Beta]2", "\[Rule]", "0.1`"}], ",", 
     RowBox[{"\[Iota]12", "\[Rule]", "0.05"}], ",", 
     RowBox[{"\[Iota]21", "\[Rule]", "0.05"}], ",", 
     RowBox[{"\[Eta]1", "\[Rule]", "2"}], ",", 
     RowBox[{"\[Eta]2", "\[Rule]", "2"}]}], "}"}]}], ";", 
  RowBox[{"eq", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"realEq", "=", 
    RowBox[{"eq", "\[LeftDoubleBracket]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Intersection", "[", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"eq", "\[LeftDoubleBracket]", 
           RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
              SuperscriptBox["10", 
               RowBox[{"-", "6"}]]}], "&&", 
             RowBox[{
              RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"eq", "\[LeftDoubleBracket]", 
           RowBox[{";;", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
              SuperscriptBox["10", 
               RowBox[{"-", "6"}]]}], "&&", 
             RowBox[{
              RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}]}],
        "]"}], "]"}], "\[RightDoubleBracket]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "stable", " ", "equilibria", " ", "have", " ", "a", " ", "positive", " ", 
    "determinant", " ", "and", " ", "a", " ", "negative", " ", "trace"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableInds", "=", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
