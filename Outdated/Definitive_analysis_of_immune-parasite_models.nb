          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", " ", "\[Beta]1"}], "-", 
            RowBox[{"20", " ", 
             SuperscriptBox["\[Beta]1", "2"]}], "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["\[Beta]1", "3"]}], "-", 
            RowBox[{"4", " ", "\[Beta]1", " ", "\[Sigma]1"}], "+", 
            RowBox[{"4", " ", 
             SuperscriptBox["\[Beta]1", "2"], " ", "\[Sigma]1"}]}], ")"}], 
          " ", "#1"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"16", " ", "\[Beta]1"}], "-", 
            RowBox[{"16", " ", 
             SuperscriptBox["\[Beta]1", "2"]}], "-", 
            RowBox[{"10", " ", "\[Beta]1", " ", "\[Sigma]1"}]}], ")"}], " ", 
