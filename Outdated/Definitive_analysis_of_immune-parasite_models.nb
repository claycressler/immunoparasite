Cell[TextData[{
 "But if you start unbalanced ",
 StyleBox["at all",
  FontSlant->"Italic"],
 ", one of the responses blows up and the other decays to nothing. I need to \
modify the model, clearly, to prevent this blowup from happening."
}], "Text",
 CellChangeTimes->{{3.796667456554955*^9, 3.7966675324479*^9}, {
  3.7967315297395678`*^9, 
  3.796731540571061*^9}},ExpressionUUID->"f983d302-bb6d-417a-beb9-\
ecaae21ec842"],

