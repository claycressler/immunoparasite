Cell["\<\
Addition of APCs also has no effect on the timecourse of cytokine.\
\>", "Text",
 CellChangeTimes->{{3.796139866075932*^9, 
  3.796139892299687*^9}},ExpressionUUID->"8ce9a284-f7c1-4a8e-9633-\
49d643abccf3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"timeToEq2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", "1000"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<", "1001"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cd", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"c", ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          SuperscriptBox["10", "6"], ",", 
          SuperscriptBox["10", "9"], ",", 
          SuperscriptBox["10", "6"]}], "}"}]}], "]"}], "\[LeftDoubleBracket]",
       "i", "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"sol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"TF1", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dTF1dt2", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params2"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"TF2", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dTF2dt2", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params2"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"CY1", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dCY1dt2", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params2"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"CY2", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dCY2dt2", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params2"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"TF1", "[", "0", "]"}], "\[Equal]", "20"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"TF2", "[", "0", "]"}], "\[Equal]", "20"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CY1", "[", "0", "]"}], "\[Equal]", "100"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CY2", "[", "0", "]"}], "\[Equal]", "100"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"TF1", ",", "TF2", ",", "CY1", ",", "CY2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "10000"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "timeToEq2", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
     RowBox[{"{", 
      RowBox[{"cd", ",", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"CY2", "[", "t", "]"}], "/", 
                    RowBox[{"CY2", "[", "10000", "]"}]}], ")"}], "/.", 
                  "sol"}], ")"}], "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "10", ",", "10000", ",", "1"}], "}"}]}], 
            "]"}], ",", 
           RowBox[{"x_", "/;", 
