Cell["\<\
But if you strengthen the baseline immune response, you end up with three \
equilibria representing polarization and high co-expression. Any further \
strengthening and the only stable equilibrium is high co-expression.\
\>", "Text",
 CellChangeTimes->{{3.797256746256078*^9, 
  3.797256800121409*^9}},ExpressionUUID->"b13d41e6-7068-4b5f-be85-\
ffa6f056dbfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Sigma]1", "\[Rule]", "2"}], ",", 
     RowBox[{"\[Sigma]2", "\[Rule]", "2"}], ",", 
     RowBox[{"\[Beta]1", "\[Rule]", "0.15"}], ",", 
     RowBox[{"\[Beta]2", "\[Rule]", "0.15"}], ",", 
     RowBox[{"\[Iota]12", "\[Rule]", "10"}], ",", 
     RowBox[{"\[Iota]21", "\[Rule]", "10"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realEq", "=", 
   RowBox[{"eq", "\[LeftDoubleBracket]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}]}], 
      "]"}], "]"}], "\[RightDoubleBracket]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "stable", " ", "equilibria", " ", "have", " ", "a", " ", "positive", " ", 
    "determinant", " ", "and", " ", "a", " ", "negative", " ", "trace"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableInds", "=", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", "<", "0"}]}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"unstableInds", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "realEq", "]"}]}], "}"}]}], "]"}], ",", 
     "stableInds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"th1", ",", 
         RowBox[{
          RowBox[{"th1isocline", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], "/.",
           "params"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"th1", ",", "0.01", ",", "20", ",", "0.01"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Orange"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Th1 isocline\>\"", ",", "\"\<Th2 isocline\>\""}], 
         "}"}]}], "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"th2isocline", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], "/.",
           "params"}], ",", "th2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"th2", ",", "0.01", ",", "20", ",", "0.01"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Orange"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"realEq", "\[LeftDoubleBracket]", 
      RowBox[{"stableInds", ",", ";;", ",", "2"}], "\[RightDoubleBracket]"}], 
     ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"realEq", "\[LeftDoubleBracket]", 
      RowBox[{"unstableInds", ",", ";;", ",", "2"}], 
      "\[RightDoubleBracket]"}], ",", 
     RowBox[{"PlotMarkers", "\[Rule]", "\"\<OpenMarkers\>\""}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", "Black", "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"VectorPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dth1", "/.", "params"}], ",", 
       RowBox[{"dth2", "/.", "params"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"th1", ",", 
       RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"th2", ",", 
       RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
     RowBox[{"VectorScale", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0.025", ",", "0.9", ",", "None"}], "}"}]}], ",", 
     RowBox[{"VectorColorFunction", "\[Rule]", "None"}], ",", " ", 
     RowBox[{"VectorStyle", "\[Rule]", 
      RowBox[{"Gray", "[", "0.8", "]"}]}], ",", 
     RowBox[{"VectorPoints", "\[Rule]", "30"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Th1\>\"", ",", "\"\<Th2\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
