        MultilineFunction->None], "[", "Th1", "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", "m"}], "+", 
      RowBox[{"s2", "[", "Th2", "]"}], "+", 
      RowBox[{"Th2", " ", 
       RowBox[{
        SuperscriptBox["s2", "\[Prime]",
         MultilineFunction->None], "[", "Th2", "]"}]}]}]}], "}"}]}], 
  "}"}]], "Output",
