     RowBox[{"\[Beta]2", "\[Rule]", "0.12"}], ",", 
     RowBox[{"\[Iota]12", "\[Rule]", "10"}], ",", 
     RowBox[{"\[Iota]21", "\[Rule]", "10"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realEq", "=", 
   RowBox[{"eq", "\[LeftDoubleBracket]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}]}], 
      "]"}], "]"}], "\[RightDoubleBracket]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "stable", " ", "equilibria", " ", "have", " ", "a", " ", "positive", " ", 
    "determinant", " ", "and", " ", "a", " ", "negative", " ", "trace"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableInds", "=", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
