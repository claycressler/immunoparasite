      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Orange"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Th1 isocline\>\"", ",", "\"\<Th2 isocline\>\""}], 
         "}"}]}], "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"th2isocline", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], "/.",
           "params"}], ",", "th2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"th2", ",", "0.1", ",", "20", ",", "0.01"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Orange"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"realEq", "\[LeftDoubleBracket]", 
      RowBox[{"stableInds", ",", ";;", ",", "2"}], "\[RightDoubleBracket]"}], 
     ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"realEq", "\[LeftDoubleBracket]", 
      RowBox[{"unstableInds", ",", ";;", ",", "2"}], 
      "\[RightDoubleBracket]"}], ",", 
