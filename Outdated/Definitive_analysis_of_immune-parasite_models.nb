Cell[TextData[{
 "Here you can see that the slope of the isoclines changes sign, but only if \
the baseline activation is fairly small ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Beta]", "i"], "<", "1"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "473a1acf-e03c-400c-9a07-ce53d9b9aef3"],
