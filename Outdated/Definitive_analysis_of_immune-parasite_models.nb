   FractionBox["\[Gamma]", 
    RowBox[{"\[Nu]", "-", 
     RowBox[{"\[Epsilon]", " ", 
      RowBox[{"\[Kappa]", "[", "p", "]"}]}]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.796059111777939*^9, 3.796059129018372*^9}, 
   3.796062173504216*^9},
