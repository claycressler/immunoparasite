Cell["Strengthening cross-inhibition:", "Text",
 CellChangeTimes->{{3.797301434925317*^9, 3.797301455568879*^9}, 
   3.7973015728958693`*^9},ExpressionUUID->"55500fad-be18-4b4c-b0f9-\
9133faa3f3e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Sigma]1", "\[Rule]", "2"}], ",", 
     RowBox[{"\[Sigma]2", "\[Rule]", "2"}], ",", 
     RowBox[{"\[Beta]1", "\[Rule]", "0.12"}], ",", 
     RowBox[{"\[Beta]2", "\[Rule]", "0.12"}], ",", 
     RowBox[{"\[Iota]12", "\[Rule]", "6"}], ",", 
     RowBox[{"\[Iota]21", "\[Rule]", "6"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realEq", "=", 
   RowBox[{"eq", "\[LeftDoubleBracket]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}]}], 
      "]"}], "]"}], "\[RightDoubleBracket]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "stable", " ", "equilibria", " ", "have", " ", "a", " ", "positive", " ", 
    "determinant", " ", "and", " ", "a", " ", "negative", " ", "trace"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableInds", "=", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", "<", "0"}]}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"unstableInds", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "realEq", "]"}]}], "}"}]}], "]"}], ",", 
     "stableInds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"th1", ",", 
         RowBox[{
          RowBox[{"th1isocline", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], "/.",
           "params"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"th1", ",", "0.1", ",", "20", ",", "0.01"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
