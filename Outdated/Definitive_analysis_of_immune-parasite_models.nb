 CellLabel->"Out[88]=",ExpressionUUID->"ab826f0b-4854-43f0-b099-c79ffd514ebf"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"chronicEquil", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"dt", "\[Equal]", "0"}], ",", "t"}], "]"}], 
   "\[LeftDoubleBracket]", "1", 
   "\[RightDoubleBracket]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tr", "[", 
   RowBox[{"J", "/.", "chronicEquil"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"needs", " ", "to", " ", "be", " ", "negative"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", 
   RowBox[{"J", "/.", "chronicEquil"}], "]"}], " "}]}], "Input",
 CellChangeTimes->{{3.796059097703746*^9, 3.7960591285826683`*^9}, {
  3.796062172952394*^9, 3.796062173099043*^9}},
 CellLabel->
  "In[124]:=",ExpressionUUID->"59a3ef5d-c9d9-452c-a768-a49db9ff48bd"],

