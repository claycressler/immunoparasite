Cell[CellGroupData[{

Cell["Final model", "Subsubsection",
 CellChangeTimes->{{3.797271098225239*^9, 
  3.79727110000224*^9}},ExpressionUUID->"a3576a14-244e-42eb-aa3d-\
fcaa468e52df"],

Cell["\<\
In this one, I allow for a slightly different functional form. Basically I \
have a function that controls the strength of self-promotion, with inhibition.\
\>", "Text",
 CellChangeTimes->{{3.797271163902115*^9, 
  3.7972712091837397`*^9}},ExpressionUUID->"17215cbb-0022-415d-81fc-\
e1797c678ba6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dTh1", "=", 
   RowBox[{"b1", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s1", " ", "Th1"}], 
      RowBox[{"S1", "+", "Th1"}]], " ", 
     FractionBox[
