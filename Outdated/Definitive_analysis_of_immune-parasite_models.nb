   RowBox[{"s2", "[", "Th2", "]"}]}], "+", 
  RowBox[{
   RowBox[{"s1", "[", "Th1", "]"}], " ", 
   RowBox[{"s2", "[", "Th2", "]"}]}], "-", 
  RowBox[{
   RowBox[{
    SuperscriptBox["i1", "\[Prime]",
     MultilineFunction->None], "[", "Th2", "]"}], " ", 
   RowBox[{
    SuperscriptBox["i2", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}]}], "-", 
  RowBox[{"m", " ", "Th1", " ", 
   RowBox[{
    SuperscriptBox["s1", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}]}], "+", 
  RowBox[{"Th1", " ", 
   RowBox[{"s2", "[", "Th2", "]"}], " ", 
   RowBox[{
    SuperscriptBox["s1", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}]}], "-", 
  RowBox[{"m", " ", "Th2", " ", 
   RowBox[{
    SuperscriptBox["s2", "\[Prime]",
     MultilineFunction->None], "[", "Th2", "]"}]}], "+", 
  RowBox[{"Th2", " ", 
   RowBox[{"s1", "[", "Th1", "]"}], " ", 
   RowBox[{
    SuperscriptBox["s2", "\[Prime]",
     MultilineFunction->None], "[", "Th2", "]"}]}], "+", 
  RowBox[{"Th1", " ", "Th2", " ", 
   RowBox[{
    SuperscriptBox["s1", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}], " ", 
   RowBox[{
    SuperscriptBox["s2", "\[Prime]",
     MultilineFunction->None], "[", "Th2", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.796646409771388*^9, 3.79664643078927*^9}, 
   3.7966465987718554`*^9, 3.796646818208111*^9, 3.7966560793091784`*^9},
 CellLabel->
