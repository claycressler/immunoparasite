Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"th1", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dth1", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"th1", "\[Rule]", 
              RowBox[{"th1", "[", "t", "]"}]}], ",", 
             RowBox[{"th2", "\[Rule]", 
              RowBox[{"th2", "[", "t", "]"}]}]}], "}"}]}], "/.", "params"}], 
         ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"th2", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dth2", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"th1", "\[Rule]", 
              RowBox[{"th1", "[", "t", "]"}]}], ",", 
             RowBox[{"th2", "\[Rule]", 
              RowBox[{"th2", "[", "t", "]"}]}]}], "}"}]}], "/.", "params"}], 
         ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"th1", "[", "0", "]"}], "\[Equal]", "0.2"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"th2", "[", "0", "]"}], "\[Equal]", "0.1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"th1", ",", "th2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"th1", "[", "t", "]"}], "/.", "sol"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Black"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"th2", "[", "t", "]"}], "/.", "sol"}], ",", 
