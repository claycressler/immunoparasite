      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"dt2", "\[Equal]", "0"}], ",", "p"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Parameters", " ", "that", " ", "produce", " ", "bistability"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"params", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Sigma]", "\[Rule]", "0.2"}], ",", 
       RowBox[{"\[Delta]", "\[Rule]", "1"}], ",", 
       RowBox[{"\[Chi]", "\[Rule]", "0.2"}], ",", 
       RowBox[{"\[Alpha]", "\[Rule]", "1"}], ",", 
       RowBox[{"\[Mu]", "\[Rule]", "0.4"}], ",", 
       RowBox[{"\[Gamma]", "\[Rule]", "0.15"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Individual", " ", "simulations", " ", "showing", " ", "alternative", " ",
      "outcomes", " ", "from", " ", "different", " ", "initial", " ", 
     "conditions", " ", "of", " ", "parasite", " ", "and", " ", "immunity"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
