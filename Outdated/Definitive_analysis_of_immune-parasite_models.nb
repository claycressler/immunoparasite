 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"The", " ", "model"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dp2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], " ", "p", " ", "\[Alpha]"}], "-", 
      RowBox[{"p", " ", "t", " ", "\[Mu]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dt2", "=", 
     FractionBox[
      RowBox[{"\[Gamma]", "+", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{"t", "-", "\[Delta]", "+", 
          RowBox[{"p", " ", "\[Sigma]"}], "-", 
          RowBox[{
           SuperscriptBox["t", "2"], " ", "\[Chi]"}]}], ")"}]}]}], 
      "\[Delta]"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Isoclines", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"pisocline", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"dp2", "\[Equal]", "0"}], ",", "p"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tisocline", "=", 
