Cell["\<\
You can also see how long it takes to reach equilibrium as a function of cell \
density:\
\>", "Text",
 CellChangeTimes->{{3.796138458305429*^9, 
  3.796138484078774*^9}},ExpressionUUID->"1338a476-88e5-41f2-9dee-\
1736a9e8db32"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"timeToEq", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", "1000"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<", "1001"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cd", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"c", ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          SuperscriptBox["10", "6"], ",", 
          SuperscriptBox["10", "9"], ",", 
          SuperscriptBox["10", "6"]}], "}"}]}], "]"}], "\[LeftDoubleBracket]",
       "i", "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"sol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"TF1", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dTF1dt", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"TF2", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dTF2dt", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"CY1", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dCY1dt", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"CY2", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"dCY2dt", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TF1", "\[Rule]", 
                 RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                RowBox[{"TF2", "\[Rule]", 
                 RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                RowBox[{"CY1", "\[Rule]", 
                 RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                RowBox[{"CY2", "\[Rule]", 
                 RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
             "params"}], "/.", 
            RowBox[{"{", 
             RowBox[{"cvpc", "\[Rule]", 
              FractionBox[
               RowBox[{"1", "-", 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]}], 
               RowBox[{"cd", " ", 
                RowBox[{"180", "/", 
                 SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"TF1", "[", "0", "]"}], "\[Equal]", "20"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"TF2", "[", "0", "]"}], "\[Equal]", "20"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CY1", "[", "0", "]"}], "\[Equal]", "100"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"CY2", "[", "0", "]"}], "\[Equal]", "100"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"TF1", ",", "TF2", ",", "CY1", ",", "CY2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "10000"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "timeToEq", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "=", 
     
     RowBox[{"{", 
      RowBox[{"cd", ",", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"CY2", "[", "t", "]"}], "/", 
                    RowBox[{"CY2", "[", "10000", "]"}]}], ")"}], "/.", 
                  "sol"}], ")"}], "\[LeftDoubleBracket]", "1", 
                "\[RightDoubleBracket]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "10", ",", "10000", ",", "1"}], "}"}]}], 
            "]"}], ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "<", "0.1"}]}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.79613633944105*^9, 3.796136370265417*^9}, 
   3.796136507696437*^9, {3.7961370635736322`*^9, 3.796137078669231*^9}, {
   3.796137738856328*^9, 3.796137846496279*^9}, {3.796138280278467*^9, 
   3.796138284832054*^9}},
 CellLabel->
  "In[497]:=",ExpressionUUID->"5b013ec0-c730-492c-98a9-a32a7af13f2a"],

