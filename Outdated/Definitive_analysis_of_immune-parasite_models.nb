Cell[TextData[{
 "Here I get the final CY and TF expression across a range of cell densities, \
from ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "6"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "a2ea845c-15f4-4730-8f7d-93ad11622318"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "9"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9f09caf1-e5fa-496f-a7ca-3c34c5809b51"],
 " cells/mL."
}], "Text",
 CellChangeTimes->{{3.7961339011726217`*^9, 
  3.796133980373724*^9}},ExpressionUUID->"5a284ac6-807d-4e02-8b1d-\
ba6f92384fe0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EQbyCD", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cd", ",", 
        RowBox[{"TF1", "[", "10000", "]"}], ",", 
        RowBox[{"TF2", "[", "10000", "]"}], ",", 
        RowBox[{"CY1", "[", "10000", "]"}], ",", 
        RowBox[{"CY2", "[", "10000", "]"}]}], "}"}], "/.", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"TF1", "'"}], "[", "t", "]"}], "\[Equal]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dTF1dt", "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"TF1", "\[Rule]", 
                  RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                 RowBox[{"TF2", "\[Rule]", 
                  RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                 RowBox[{"CY1", "\[Rule]", 
                  RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                 RowBox[{"CY2", "\[Rule]", 
                  RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
              "params"}], "/.", 
             RowBox[{"{", 
              RowBox[{"cvpc", "\[Rule]", 
               FractionBox[
                RowBox[{"1", "-", 
                 RowBox[{"cd", " ", 
                  RowBox[{"180", "/", 
                   SuperscriptBox["10", "12"]}]}]}], 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"TF2", "'"}], "[", "t", "]"}], "\[Equal]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dTF2dt", "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"TF1", "\[Rule]", 
                  RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                 RowBox[{"TF2", "\[Rule]", 
                  RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                 RowBox[{"CY1", "\[Rule]", 
                  RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                 RowBox[{"CY2", "\[Rule]", 
                  RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
              "params"}], "/.", 
             RowBox[{"{", 
              RowBox[{"cvpc", "\[Rule]", 
               FractionBox[
                RowBox[{"1", "-", 
                 RowBox[{"cd", " ", 
                  RowBox[{"180", "/", 
                   SuperscriptBox["10", "12"]}]}]}], 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"CY1", "'"}], "[", "t", "]"}], "\[Equal]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dCY1dt", "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"TF1", "\[Rule]", 
                  RowBox[{"TF1", "[", "t", "]"}]}], ",", 
                 RowBox[{"TF2", "\[Rule]", 
                  RowBox[{"TF2", "[", "t", "]"}]}], ",", 
                 RowBox[{"CY1", "\[Rule]", 
                  RowBox[{"CY1", "[", "t", "]"}]}], ",", 
                 RowBox[{"CY2", "\[Rule]", 
                  RowBox[{"CY2", "[", "t", "]"}]}]}], "}"}]}], "/.", 
              "params"}], "/.", 
             RowBox[{"{", 
              RowBox[{"cvpc", "\[Rule]", 
               FractionBox[
                RowBox[{"1", "-", 
                 RowBox[{"cd", " ", 
                  RowBox[{"180", "/", 
                   SuperscriptBox["10", "12"]}]}]}], 
                RowBox[{"cd", " ", 
                 RowBox[{"180", "/", 
                  SuperscriptBox["10", "12"]}]}]]}], "}"}]}], ")"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"CY2", "'"}], "[", "t", "]"}], "\[Equal]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dCY2dt", "/.", 
               RowBox[{"{", 
                RowBox[{
