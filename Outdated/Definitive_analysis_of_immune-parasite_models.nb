Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Here", " ", "are", " ", "the", " ", "equilibria"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"equil", "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"dp", "\[Equal]", "0"}], ",", "p"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "\[Rule]", "0.5"}], ",", 
       RowBox[{"K", "\[Rule]", "100"}], ",", 
       RowBox[{"a", "\[Rule]", "0.005"}], ",", 
       RowBox[{"Th", "\[Rule]", "2"}], ",", 
       RowBox[{"t", "\[Rule]", "20"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"The", " ", "middle", " ", "two", " ", "are", " ", "stable"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"dp", ",", "p"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "\[Rule]", "0.5"}], ",", 
       RowBox[{"K", "\[Rule]", "100"}], ",", 
       RowBox[{"a", "\[Rule]", "0.005"}], ",", 
       RowBox[{"Th", "\[Rule]", "2"}], ",", 
       RowBox[{"t", "\[Rule]", "20"}]}], "}"}]}], "/.", 
    "equil"}]}]}]], "Input",
 CellChangeTimes->{{3.79606797482906*^9, 3.796068061936286*^9}},
 CellLabel->
  "In[167]:=",ExpressionUUID->"c8c3dbd5-4584-4c9a-8a3a-ec5c58c20560"],

