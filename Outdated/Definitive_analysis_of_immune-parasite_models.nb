       RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], "2"], " ", 
    RowBox[{"(", 
     RowBox[{"th1", "+", 
      SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
      RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}]}]], "+", 
  FractionBox[
   RowBox[{"4", " ", 
    SuperscriptBox["th1", "2"], " ", "\[Iota]12", " ", "\[Iota]21", " ", 
    "\[Sigma]1", " ", "\[Sigma]2"}], 
   RowBox[{
    RowBox[{"(", 
