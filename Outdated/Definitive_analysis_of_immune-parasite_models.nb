Cell["\<\
One last addition that Ed considers is the effect of instruction by \
antigen-presenting cells (APCs). \[OpenCurlyDoubleQuote]Biologically, APCs \
provide Th1 or Th2 instructions by secreting Th1- or Th2-driving cytokines \
directly onto a Th cell surface. Therefore, we included APC instruction by \
augmenting every appearance of CY1 and CY2 (except decay) in the model \
equations with constants APC1 and APC2, whose values depend on the \
frequencies of Type 1 and Type 2 APCs, respectively.\[CloseCurlyDoubleQuote]

That leads to the following set of equations:\
\>", "Text",
 CellChangeTimes->{{3.7960725086657476`*^9, 3.796072567402334*^9}, {
  3.796138505971807*^9, 3.796138772351204*^9}, {3.7961391404172277`*^9, 
  3.7961391459636707`*^9}},ExpressionUUID->"431d9a91-40b5-480f-a3e6-\
ba1deace8641"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dTF1dt2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "+", 
       FractionBox[
        RowBox[{"p1", " ", 
         SuperscriptBox["TF1", "hp"]}], 
        RowBox[{
         SuperscriptBox["P1", "hp"], "+", 
         SuperscriptBox["TF1", "hp"]}]]}], ")"}], " ", 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["X2", "hx"], 
       RowBox[{
        SuperscriptBox["X2", "hx"], "+", 
        SuperscriptBox["TF2", "hx"]}]], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"s1", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY1", "+", "APC1"}], ")"}], "hs"]}], 
       RowBox[{
        SuperscriptBox["S1", "hs"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY1", "+", "APC1"}], ")"}], "hs"]}]], ")"}], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["Z2", "hz"], 
       RowBox[{
        SuperscriptBox["Z2", "hz"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY2", "+", "APC2"}], ")"}], "hz"]}]], ")"}]}], "-", 
    RowBox[{"dTF1", " ", "TF1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dTF2dt2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "+", 
       FractionBox[
        RowBox[{"p2", " ", 
         SuperscriptBox["TF2", "hp"]}], 
        RowBox[{
         SuperscriptBox["P2", "hp"], "+", 
         SuperscriptBox["TF2", "hp"]}]]}], ")"}], " ", 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["X1", "hx"], 
       RowBox[{
        SuperscriptBox["X1", "hx"], "+", 
        SuperscriptBox["TF1", "hx"]}]], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"s2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY2", "+", "APC2"}], ")"}], "hs"]}], 
       RowBox[{
        SuperscriptBox["S2", "hs"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY2", "+", "APC2"}], ")"}], "hs"]}]], ")"}], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["Z1", "hz"], 
       RowBox[{
        SuperscriptBox["Z1", "hz"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY1", "+", "APC1"}], ")"}], "hz"]}]], ")"}]}], "-", 
    RowBox[{"dTF2", " ", "TF2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dCY1dt2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"a1", " ", 
        SuperscriptBox["TF1", "ha"]}], 
       RowBox[{
        SuperscriptBox["A1", "ha"], "+", 
        SuperscriptBox["TF1", "ha"]}]], ")"}], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["R2", "hr"], 
       RowBox[{
        SuperscriptBox["R2", "hr"], "+", 
        SuperscriptBox["TF2", "hr"]}]], ")"}], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["U2", "hu"], 
       RowBox[{
        SuperscriptBox["U2", "hu"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY2", "+", "APC2"}], ")"}], "hu"]}]], ")"}]}], "-", 
    RowBox[{"dCY1", " ", "CY1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dCY2dt2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"a2", " ", 
        SuperscriptBox["TF2", "ha"]}], 
       RowBox[{
        SuperscriptBox["A2", "ha"], "+", 
        SuperscriptBox["TF2", "ha"]}]], ")"}], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["R1", "hr"], 
       RowBox[{
        SuperscriptBox["R1", "hr"], "+", 
        SuperscriptBox["TF1", "hr"]}]], ")"}], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["U1", "hu"], 
       RowBox[{
        SuperscriptBox["U1", "hu"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"CY1", "+", "APC1"}], ")"}], "hu"]}]], ")"}]}], "-", 
    RowBox[{"dCY2", " ", "CY2"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.796072161537985*^9, 3.796072187051038*^9}, {
  3.796072238215931*^9, 3.796072478516205*^9}, {3.796072590964608*^9, 
  3.7960725938969316`*^9}, {3.796138842695404*^9, 3.796138882051939*^9}, {
  3.796139136020668*^9, 3.796139138967963*^9}, {3.7966396372935534`*^9, 
  3.79663963925882*^9}},
 CellLabel->
  "In[598]:=",ExpressionUUID->"662209a8-98cf-48e2-aac0-909855d77370"],

Cell[TextData[{
 "We also have to add terms for APC1 and APC2 to our parameter list. \n\n\
However, this is defined in a somewhat obscure way in Ed\[CloseCurlyQuote]s \
paper: \[OpenCurlyDoubleQuote]0.003 or 0.17 * (98% effective concentration of \
CY): The first term is the per-hour probability of an antigen-specific Th \
cell encountering a dendritic cell, which ranges from 0.003 to 0.17 at \
biologically realistic dendritic cell frequencies. The second term assumes \
the influence of a Type-1 APC is as strong as the concentration of CY1 that \
would stimulate 98% of Th cells to produce TF1.\[CloseCurlyDoubleQuote] The \
second part of this is ambiguous to me, because it\[CloseCurlyQuote]s unclear \
if this means: \[OpenCurlyDoubleQuote]would stimulate 98% of Th cells to \
produce TF1 ",
 StyleBox["in the absence of any influence from CY2 and TF2",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] or not. \n\nBased on an email from Ed, this is how \
these values were calculated - he did ignore the influence of CY2 and TF1/2:"
}], "Text",
 CellChangeTimes->{{3.7961404093957443`*^9, 3.796140624811184*^9}, 
   3.796141571715466*^9, {3.796639077908835*^9, 3.796639095256728*^9}, {
   3.796639161420209*^9, 
   3.796639180973042*^9}},ExpressionUUID->"1115503d-b4d6-476a-b155-\
e05f2eb75ab8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", "CY1", ")"}], "hs"], 
       RowBox[{
        SuperscriptBox["S1", "hs"], "+", 
        SuperscriptBox[
         RowBox[{"(", "CY1", ")"}], "hs"]}]], "/.", "params"}], ")"}], 
    "\[Equal]", "0.98"}], ",", "CY1"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
