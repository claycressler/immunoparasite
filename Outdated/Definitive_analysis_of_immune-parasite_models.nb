Cell[CellGroupData[{

Cell["A different take on the model", "Subsubsection",
 CellChangeTimes->{{3.7966573150680733`*^9, 
  3.796657322976688*^9}},ExpressionUUID->"eed72385-906e-44f2-bbc9-\
d31fa4d17de9"],

Cell["\<\
 I don\[CloseCurlyQuote]t think it makes sense to have the effect of Th1 on \
Th2 (and vice versa) modeled as a negative term. Rather it should be modeled \
as a multiplier on the proliferation rate, slowing Th1 proliferation.\
\>", "Text",
 CellChangeTimes->{{3.7966573259013357`*^9, 
  3.796657372656864*^9}},ExpressionUUID->"c97fd6dd-c41d-48c0-a090-\
4d8023e71471"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dTh1", "=", 
   RowBox[{"b1", "+", 
    RowBox[{
     RowBox[{"s1", "[", "Th1", "]"}], 
     RowBox[{"i1", "[", "Th2", "]"}], "Th1"}], "-", 
    RowBox[{"m", " ", "Th1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dTh2", "=", 
   RowBox[{"b2", "+", 
    RowBox[{
     RowBox[{"s2", "[", "Th2", "]"}], 
     RowBox[{"i2", "[", "Th1", "]"}], "Th2"}], "-", 
    RowBox[{"m", " ", "Th2"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.796657376833766*^9, 3.7966573918626947`*^9}},
 CellLabel->
  "In[858]:=",ExpressionUUID->"1f223f83-f34a-43c8-a701-491e0f65cf9a"],

Cell["\<\
The first thing to note here is that there is no way to get an equilibrium \
with either Th1=0 or Th2=0. This makes sense biologically, since in reality \
even a polarized response doesn\[CloseCurlyQuote]t have the entire cell \
population becoming \
\>", "Text",
 CellChangeTimes->{{3.796657402829131*^9, 
  3.7966574469071283`*^9}},ExpressionUUID->"a965df8e-78c3-42b1-9862-\
ae66ebe482a3"],

Cell["Here is the Jacobian:", "Text",
 CellChangeTimes->{{3.796645084000669*^9, 
  3.796645086137969*^9}},ExpressionUUID->"7fadae3c-47b5-4283-b5a5-\
32551dfc6010"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"J", "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dTh1", ",", "dTh2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Th1", ",", "Th2"}], "}"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.796645064388337*^9, 3.796645089355608*^9}},
 CellLabel->
  "In[860]:=",ExpressionUUID->"7c2e1da4-52ab-4a47-ab36-811fd82298f8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "m"}], "+", 
      RowBox[{
       RowBox[{"i1", "[", "Th2", "]"}], " ", 
       RowBox[{"s1", "[", "Th1", "]"}]}], "+", 
      RowBox[{"Th1", " ", 
       RowBox[{"i1", "[", "Th2", "]"}], " ", 
       RowBox[{
        SuperscriptBox["s1", "\[Prime]",
         MultilineFunction->None], "[", "Th1", "]"}]}]}], ",", 
     RowBox[{"Th1", " ", 
      RowBox[{"s1", "[", "Th1", "]"}], " ", 
      RowBox[{
       SuperscriptBox["i1", "\[Prime]",
        MultilineFunction->None], "[", "Th2", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Th2", " ", 
      RowBox[{"s2", "[", "Th2", "]"}], " ", 
      RowBox[{
       SuperscriptBox["i2", "\[Prime]",
        MultilineFunction->None], "[", "Th1", "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", "m"}], "+", 
      RowBox[{
       RowBox[{"i2", "[", "Th1", "]"}], " ", 
       RowBox[{"s2", "[", "Th2", "]"}]}], "+", 
      RowBox[{"Th2", " ", 
       RowBox[{"i2", "[", "Th1", "]"}], " ", 
       RowBox[{
        SuperscriptBox["s2", "\[Prime]",
         MultilineFunction->None], "[", "Th2", "]"}]}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.796645073423328*^9, 3.7966450898880167`*^9}, 
   3.796646815947878*^9, 3.796655194669506*^9, 3.796658051466057*^9},
 CellLabel->
  "Out[860]=",ExpressionUUID->"54e44eec-816e-4dfb-9c84-5d1c44321040"]
}, Open  ]],

Cell["\<\
If we assume that, in a biased response, Th1 or Th2 are ~0, we can get some \
insights. Note that I\[CloseCurlyQuote]m going to assume that if Th2=0, the \
positive self-stimulation is also 0, but the inhibitory effects of Th2 on i1 \
do not go to zero, but rather to 1 (that is, there is no inhibitory effect). \
For a stable equilibrium, we require a negative  trace and a positive \
determinant. From this analysis, as long as Abs(Tr(J)) > m, then this should \
be stable. This strongly indicates that we will need some kind of saturating \
effect of Th1 on self-promotion. \
\>", "Text",
 CellChangeTimes->{{3.796658074635971*^9, 3.796658083636106*^9}, {
  3.796658306929051*^9, 3.79665831688275*^9}, {3.796658376586732*^9, 
  3.796658382898288*^9}, {3.796658420923414*^9, 3.79665849467857*^9}, {
  3.796658635304428*^9, 
  3.796658791960577*^9}},ExpressionUUID->"93261ab4-75ff-4b55-8aad-\
e1ac8e320fc3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Tr", "[", "J", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"Th2", "\[Rule]", "0"}], "}"}]}], "/.", 
   RowBox[{
    RowBox[{"s2", "[", "0", "]"}], "\[Rule]", "0"}]}], "/.", 
  RowBox[{
   RowBox[{"i1", "[", "0", "]"}], "\[Rule]", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Det", "[", "J", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", "m"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Tr", "[", "J", "]"}], "+", "m"}], ")"}]}]}], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{"Th2", "\[Rule]", "0"}], "}"}]}], "/.", 
    RowBox[{
     RowBox[{"s2", "[", "0", "]"}], "\[Rule]", "0"}]}], "/.", 
   RowBox[{
    RowBox[{"i1", "[", "0", "]"}], "\[Rule]", "1"}]}], "//", 
  "Simplify"}]}], "Input",
 CellChangeTimes->{{3.796658064064993*^9, 3.796658064927791*^9}, {
  3.7966583204296703`*^9, 3.796658390484498*^9}, {3.7966584995292473`*^9, 
  3.7966586322217073`*^9}},
 CellLabel->
  "In[884]:=",ExpressionUUID->"5c90c333-f0dd-46ec-a6f7-194b189ff572"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], " ", "m"}], "+", 
  RowBox[{"s1", "[", "Th1", "]"}], "+", 
  RowBox[{"Th1", " ", 
   RowBox[{
    SuperscriptBox["s1", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.79665858650331*^9, 3.7966586324874563`*^9}},
 CellLabel->
  "Out[884]=",ExpressionUUID->"285705e0-b873-43c2-b865-87f45ac7bc39"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.79665858650331*^9, 3.796658632492166*^9}},
 CellLabel->
  "Out[885]=",ExpressionUUID->"08bc14af-03e5-44a5-89c7-7055cb043bf5"]
}, Open  ]],

Cell["\<\
For the intermediate equilibrium to be a saddle, we will require the \
determinant to be negative.\
\>", "Text",
 CellChangeTimes->{{3.796658801703102*^9, 
  3.796658828815631*^9}},ExpressionUUID->"e7270f2d-92ec-45d9-aca0-\
ecc4ad31f41a"],

