       RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}], "2"]}]], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["th1", "4"], " ", "\[Iota]12", " ", "\[Iota]21", " ", 
    "\[Sigma]1", " ", "\[Sigma]2"}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"th1", "+", 
      SuperscriptBox["th1", "2"], "+", "\[CapitalIota]12", "+", 
      RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}], "2"]}]], "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["th1", "5"], " ", "\[Iota]12", " ", "\[Iota]21", " ", 
    "\[CapitalIota]21", " ", "\[Sigma]1", " ", "\[Sigma]2"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]12", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}], "2"]}]], "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["th1", "4"], " ", "\[Iota]12", " ", "\[CapitalIota]12", 
    " ", "\[Iota]21", " ", "\[CapitalIota]21", " ", "\[Sigma]1", " ", 
    "\[Sigma]2"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]12", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}], "2"]}]], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["th1", "3"], " ", "\[Iota]12", " ", "\[Iota]21", " ", 
    "\[CapitalIota]21", " ", "\[Sigma]1", " ", "\[Sigma]2"}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"th1", "+", 
      SuperscriptBox["th1", "2"], "+", "\[CapitalIota]12", "+", 
      RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}], "2"]}]], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["th1", "4"], " ", "\[Iota]12", " ", "\[Iota]21", " ", 
    "\[Sigma]1", " ", "\[Sigma]2"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
       SuperscriptBox["th1", "2"], "+", "\[CapitalIota]12", "+", 
       RowBox[{"th1", " ", "\[CapitalIota]12"}]}], ")"}], "2"], " ", 
    RowBox[{"(", 
     RowBox[{"th1", "+", 
      SuperscriptBox["th1", "2"], "+", "\[CapitalIota]21", "+", 
      RowBox[{"th1", " ", "\[CapitalIota]21"}]}], ")"}]}]], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["th1", "3"], " ", "\[Iota]12", " ", "\[CapitalIota]12", 
    " ", "\[Iota]21", " ", "\[Sigma]1", " ", "\[Sigma]2"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "+", 
