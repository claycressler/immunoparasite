Cell["\<\
We can simplify a bit by assuming that everything is balanced. Then the \
coexistence equilibrium values will be identical for th1 and th2.\
\>", "Text",
 CellChangeTimes->{{3.796666169060903*^9, 3.796666196787037*^9}, {
  3.796666227735922*^9, 
  3.7966662327199907`*^9}},ExpressionUUID->"6d1ce8af-b674-4f00-ba43-\
0eba2ffc6afb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tr", "[", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{"th2", "\[Rule]", "th1"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", 
