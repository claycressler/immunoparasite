Cell[CellGroupData[{

Cell["Consider this model", "Subsubsection",
 CellChangeTimes->{{3.796731557885154*^9, 3.796731559763797*^9}, {
  3.797248224985718*^9, 
  3.797248227201269*^9}},ExpressionUUID->"8c451e34-a79e-44e7-bb94-\
5bb92322dd69"],

Cell[TextData[{
 "In this model, I assume that there is a baseline rate of Th1 and Th2 \
proliferation, specified by the parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d5a55f8f-4556-4392-8165-e3ed83d623d4"],
 ". I assume that self-promotion follows a Hill function with an exponent of \
2, as this generates switch-like behavior. This assumption has some support \
from other models - for example, transcription factor self-promotion (and \
cross-inhibition) allows has switch-like behavior. I assume that the opposite \
Th cell population inhibits proliferation, rather than including the opposite \
as a negative term, which would biologically be interpreted as increasing the \
loss rate of the opposite Th cell population. And I assume a baseline loss \
rate of Th cells. These assumptions lead to the following model."
}], "Text",
 CellChangeTimes->{{3.7972482314423923`*^9, 3.797248304297756*^9}, {
  3.7972483472619953`*^9, 3.797248432401791*^9}, {3.79724887715899*^9, 
  3.797248991280682*^9}},ExpressionUUID->"5123142f-a996-4767-a6e0-\
9a1d7070e13e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dTh1", "=", 
   RowBox[{"b1", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s1", " ", 
       SuperscriptBox["Th1", "2"]}], 
      RowBox[{
       SuperscriptBox["S1", "2"], "+", 
       SuperscriptBox["Th1", "2"]}]], " ", 
     FractionBox[
      RowBox[{"I12", " "}], 
      RowBox[{"I12", "+", "Th2"}]]}], " ", "-", 
    RowBox[{"m", " ", "Th1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dTh2", "=", 
   RowBox[{"b2", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s2", " ", 
       SuperscriptBox["Th2", "2"]}], 
      RowBox[{
       SuperscriptBox["S2", "2"], "+", 
       SuperscriptBox["Th2", "2"]}]], " ", 
     FractionBox[
      RowBox[{"I21", " "}], 
      RowBox[{"I21", "+", "Th1"}]]}], "-", 
    RowBox[{"m", " ", "Th2"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.796731586071199*^9, 3.796731630200124*^9}, {
   3.796741122839666*^9, 3.796741132927824*^9}, {3.796743393254848*^9, 
   3.796743396792616*^9}, {3.796743653283901*^9, 3.7967437158052197`*^9}, {
   3.796743756847563*^9, 3.796743860610216*^9}, {3.796743942015568*^9, 
   3.7967439537154293`*^9}, {3.796743996586073*^9, 3.796744008699789*^9}, {
   3.796744045556903*^9, 3.796744196261994*^9}, 3.796745669104089*^9, {
   3.7972489955375443`*^9, 3.797248997266801*^9}, {3.7972986662874928`*^9, 
   3.797298669401973*^9}},
 CellLabel->
  "In[2796]:=",ExpressionUUID->"3cddd7a0-fb13-45b9-be90-e99c6aaca601"],

Cell["\<\
Because I don\[CloseCurlyQuote]t have a good sense of what the parameters of \
this model should be, I will nondimensionalize it.\
\>", "Text",
 CellChangeTimes->{{3.797248999245418*^9, 
  3.7972490112945347`*^9}},ExpressionUUID->"b359446d-a05b-4abd-adb6-\
1058763bc203"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"dth1", "=", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["that", "TH1hat"], 
         RowBox[{"(", 
          RowBox[{"dTh1", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Th1", "\[Rule]", 
              RowBox[{"TH1hat", " ", "th1"}]}], ",", 
             RowBox[{"Th2", "\[Rule]", 
              RowBox[{"TH2hat", " ", "th2"}]}]}], "}"}]}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TH1hat", "\[Rule]", "S1"}], ",", 
          RowBox[{"TH2hat", "\[Rule]", "S2"}], ",", 
          RowBox[{"that", "\[Rule]", 
           RowBox[{"1", "/", "m"}]}]}], "}"}]}], "/.", 
       RowBox[{"b1", "\[Rule]", 
        RowBox[{"\[Beta]1", " ", "m", " ", "S1"}]}]}], "/.", 
      RowBox[{"s1", "\[Rule]", 
       RowBox[{"\[Sigma]1", " ", "m", " ", "S1"}]}]}], "/.", 
     RowBox[{"I12", "\[Rule]", 
      RowBox[{"\[Iota]12", " ", "S2"}]}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"dth2", "=", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["that", "TH2hat"], 
         RowBox[{"(", 
          RowBox[{"dTh2", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Th1", "\[Rule]", 
              RowBox[{"TH1hat", " ", "th1"}]}], ",", 
             RowBox[{"Th2", "\[Rule]", 
              RowBox[{"TH2hat", " ", "th2"}]}]}], "}"}]}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TH1hat", "\[Rule]", "S1"}], ",", 
          RowBox[{"TH2hat", "\[Rule]", "S2"}], ",", 
          RowBox[{"that", "\[Rule]", 
           RowBox[{"1", "/", "m"}]}]}], "}"}]}], "/.", 
       RowBox[{"b2", "\[Rule]", 
        RowBox[{"\[Beta]2", " ", "m", " ", "S2"}]}]}], "/.", 
      RowBox[{"s2", "\[Rule]", 
       RowBox[{"\[Sigma]2", " ", "m", " ", "S2"}]}]}], "/.", 
     RowBox[{"I21", "\[Rule]", 
      RowBox[{"\[Iota]21", " ", "S1"}]}]}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.797298674871521*^9, 3.7972986961106367`*^9}, {
  3.7972987315831614`*^9, 3.797298735991873*^9}},
 CellLabel->
  "In[2798]:=",ExpressionUUID->"344ed9dc-ad08-44df-92fd-119f8611b5be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "th1"}], "+", "\[Beta]1", "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["th1", "2"], " ", "\[Iota]12", " ", "\[Sigma]1"}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox["th1", "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"th2", "+", "\[Iota]12"}], ")"}]}]]}]], "Output",
 CellChangeTimes->{
  3.796731633236829*^9, {3.796741127137891*^9, 3.796741133455064*^9}, 
   3.796743393725812*^9, 3.796743660274767*^9, {3.7967437108602667`*^9, 
   3.7967437188234167`*^9}, {3.79674376848081*^9, 3.796743861906639*^9}, 
   3.796743954481647*^9, {3.796744003532929*^9, 3.796744009086513*^9}, {
   3.7967440535850286`*^9, 3.7967440639761868`*^9}, {3.796744121136593*^9, 
   3.7967441968991947`*^9}, 3.796745743843115*^9, 3.797249016821039*^9, {
   3.797298679079668*^9, 3.79729873653083*^9}, 3.797299615140903*^9, 
   3.797299719023881*^9, 3.797300973888073*^9},
 CellLabel->
  "Out[2798]=",ExpressionUUID->"5b40796a-a0f4-4217-ad6f-9b4719e5cb5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "th2"}], "+", "\[Beta]2", "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["th2", "2"], " ", "\[Iota]21", " ", "\[Sigma]2"}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox["th2", "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"th1", "+", "\[Iota]21"}], ")"}]}]]}]], "Output",
 CellChangeTimes->{
  3.796731633236829*^9, {3.796741127137891*^9, 3.796741133455064*^9}, 
   3.796743393725812*^9, 3.796743660274767*^9, {3.7967437108602667`*^9, 
   3.7967437188234167`*^9}, {3.79674376848081*^9, 3.796743861906639*^9}, 
   3.796743954481647*^9, {3.796744003532929*^9, 3.796744009086513*^9}, {
   3.7967440535850286`*^9, 3.7967440639761868`*^9}, {3.796744121136593*^9, 
   3.7967441968991947`*^9}, 3.796745743843115*^9, 3.797249016821039*^9, {
   3.797298679079668*^9, 3.79729873653083*^9}, 3.797299615140903*^9, 
   3.797299719023881*^9, 3.797300973918015*^9},
 CellLabel->
  "Out[2799]=",ExpressionUUID->"609f831a-516e-4233-8c82-e78b657ff060"]
}, Open  ]],

Cell[TextData[{
 "This is more interpretable. For simplicity, let\[CloseCurlyQuote]s assume \
that the parameters are balanced between the Th cell populations, so there is \
no intrinsic bias towards either a Th1 or Th2 response. \n\nThe parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "i"], "=", 
    FractionBox[
     SubscriptBox["b", "i"], 
     RowBox[{"m", " ", 
      SubscriptBox["S", "i"]}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7edb226f-623b-476a-8f7e-71f6c051bc5e"],
 " is the baseline immune supply rate divided by the rate that immune cells \
are depleted when at half the density that promotes maximal immune \
proliferation. The parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "i"], "=", 
    FractionBox[
     SubscriptBox["s", "i"], 
     RowBox[{"m", " ", 
      SubscriptBox["S", "i"]}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "867072aa-ec8c-45c6-b785-087b14460bd1"],
 " is the maximum immune proliferation rate divided by the same rate. Thus, \
rather than worrying excessively about the absolute values of these \
parameters, the more important thing is their relative value, with needing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "i"], ">>", 
    SubscriptBox["\[Beta]", "i"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1375f87a-5f89-416b-9faf-b29f9dabd5c0"],
 " since self-stimulated immune proliferation should be much higher than \
baseline immune supply. \n\nThe parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Iota]", "ij"], "=", 
    RowBox[{
     SubscriptBox["i", "ij"], "/", 
     SubscriptBox["I", "ij"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c3a9ad68-95c5-46fb-ba2c-a23cfe6c2845"],
 " is the ratio of the minimum inhibition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "j"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1d3a8c4a-0b31-44b9-a366-c346217a35d6"],
 " cells on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "29b097fe-a39f-4ade-a0ca-358d62bd66df"],
 " proliferation to the number of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "j"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6b9da91b-94a6-47e3-b3ca-61b92913849c"],
 " cells where inhibition is half is maximal value (of 0). Thus this \
parameter must be less than 0 (if the minimum inhibition is greater than 1, \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "j"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9f26f5a4-6593-47e3-a5ac-6b72e3472b41"],
 " cells actually ",
 StyleBox["fuel",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "0a4f373b-90f4-4cf9-b8fb-3ee4ecccf403"],
 " proliferation). \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "i"], "=", 
    RowBox[{
     SubscriptBox["S", "i"], "/", 
     SubscriptBox["I", "ji"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6632b3b8-d0e3-4239-858b-71c453b888f9"],
 " gives the ratio of the half-maxima for self-stimulated proliferation by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "81d43083-5330-4aa9-94cf-348f1e940734"],
 " to cross-inhibition by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "350a5c49-2c66-47ef-be5d-6b95065c6c59"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "j"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c2911cb9-3650-4f17-a559-9c60924f2538"],
 ". This should also presumably be less than 1, reflecting that \
self-promotion is greater than cross-inhibition.\n\nThe form of the isoclines \
can give good insight into the possible dynamics of the system. "
}], "Text",
 CellChangeTimes->{{3.796744863204067*^9, 3.796744982566412*^9}, {
  3.796745116228772*^9, 3.796745346538913*^9}, {3.79674541748205*^9, 
  3.796745450218279*^9}, {3.796745510845975*^9, 3.79674561760711*^9}, {
  3.796745649670163*^9, 3.796745657522422*^9}, {3.796745747140841*^9, 
  3.796745854712924*^9}, {3.797249021578272*^9, 3.7972491393330517`*^9}, {
  3.7972492789674473`*^9, 3.797249283500963*^9}, {3.7972493900493*^9, 
  3.797249453029727*^9}},ExpressionUUID->"773d24f4-c4cd-447b-9a05-\
6a0e331e6ce3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"th1isocline", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"dth1", "\[Equal]", "0"}], ",", "th2"}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"th2isocline", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"dth2", "\[Equal]", "0"}], ",", "th1"}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.796751461652462*^9, 3.796751462216481*^9}, {
  3.797298904415491*^9, 3.797298906889915*^9}, {3.797299554161566*^9, 
  3.797299555318287*^9}},
 CellLabel->
  "In[2800]:=",ExpressionUUID->"df5bce44-7f18-499f-9309-faf2b3971d52"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"th2", "\[Rule]", 
    FractionBox[
     RowBox[{"\[Iota]12", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "th1"}], "-", 
        SuperscriptBox["th1", "3"], "+", "\[Beta]1", "+", 
        RowBox[{
         SuperscriptBox["th1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"\[Beta]1", "+", "\[Sigma]1"}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["th1", "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"th1", "-", "\[Beta]1"}], ")"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.796751458708185*^9, 3.7972989071357403`*^9, {3.797299547219557*^9, 
   3.7972995555379477`*^9}, 3.7972996214901752`*^9, 3.797299726813797*^9, 
   3.797300978825553*^9},
 CellLabel->
  "Out[2800]=",ExpressionUUID->"e5276ba8-ec9d-4f19-85eb-546eb586efec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"th1", "\[Rule]", 
    FractionBox[
     RowBox[{"\[Iota]21", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "th2"}], "-", 
        SuperscriptBox["th2", "3"], "+", "\[Beta]2", "+", 
        RowBox[{
         SuperscriptBox["th2", "2"], " ", 
