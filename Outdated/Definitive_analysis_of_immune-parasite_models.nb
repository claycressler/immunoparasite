  "Out[853]=",ExpressionUUID->"3c8de354-cef0-4440-87da-f293232db294"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["m", "2"], "-", 
  RowBox[{"m", " ", 
   RowBox[{"s1", "[", "Th1", "]"}]}], "-", 
  RowBox[{
   RowBox[{
    SuperscriptBox["i1", "\[Prime]",
     MultilineFunction->None], "[", "0", "]"}], " ", 
   RowBox[{
    SuperscriptBox["i2", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}]}], "-", 
