Cell["\<\
The second model is focused on parasite-mediated feedbacks. This is a model \
that I developed that includes a very simple immune-parasite model with an \
additionally function that allows for the parasite to suppress the immune \
response. \
\>", "Text",
 CellChangeTimes->{{3.796049325960472*^9, 
  3.7960494007498503`*^9}},ExpressionUUID->"0c724f2e-9e11-45c9-9ee4-\
21b3706842a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"The", " ", "model"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dt", "=", 
     RowBox[{"\[Gamma]", "+", 
      RowBox[{"\[Beta]", " ", "p"}], "-", 
      RowBox[{"\[Nu]", " ", "t"}], "-", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"p", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "p"}], ")"}]}], " ", "t"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dp", "=", 
     RowBox[{
      RowBox[{"\[Lambda]", " ", "p", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}]}], "-", 
      RowBox[{"\[Kappa]", " ", "p", " ", "t"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"The", " ", "isoclines"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tisocline", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"dt", "\[Equal]", "0"}], ",", "t"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", "Simplify"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pisocline", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"dp", "\[Equal]", "0"}], ",", "t"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Parameters", " ", "that", " ", "produce", " ", "bistability"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"params", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Beta]", "\[Rule]", "2"}], ",", 
       RowBox[{"\[Gamma]", "\[Rule]", "1"}], ",", 
       RowBox[{"\[Kappa]", "\[Rule]", "0.8"}], ",", 
       RowBox[{"\[Lambda]", "\[Rule]", "4"}], ",", 
       RowBox[{"\[Alpha]", "\[Rule]", "3"}], ",", 
       RowBox[{"\[Nu]", "\[Rule]", "0.0001"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Individual", " ", "simulations", " ", "showing", " ", "alternative", " ",
      "outcomes", " ", "from", " ", "different", " ", "initial", " ", 
     "conditions", " ", "of", " ", "parasite", " ", "and", " ", "immunity"}], 
    " ", "*)"}], 
   RowBox[{
    RowBox[{"sol1", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p", "'"}], "[", "T", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dp", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p", "\[Rule]", 
                RowBox[{"p", "[", "T", "]"}]}], ",", 
               RowBox[{"t", "\[Rule]", 
                RowBox[{"t", "[", "T", "]"}]}]}], "}"}]}], "/.", "params"}], 
           ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "T", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dt", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p", "\[Rule]", 
                RowBox[{"p", "[", "T", "]"}]}], ",", 
               RowBox[{"t", "\[Rule]", 
                RowBox[{"t", "[", "T", "]"}]}]}], "}"}]}], "/.", "params"}], 
           ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", "0", "]"}], "\[Equal]", "0.025"}], ",", 
         RowBox[{
          RowBox[{"t", "[", "0", "]"}], "\[Equal]", "3.5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "t"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "0", ",", "50"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p", "'"}], "[", "T", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dp", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p", "\[Rule]", 
                RowBox[{"p", "[", "T", "]"}]}], ",", 
               RowBox[{"t", "\[Rule]", 
                RowBox[{"t", "[", "T", "]"}]}]}], "}"}]}], "/.", "params"}], 
           ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "T", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dt", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p", "\[Rule]", 
                RowBox[{"p", "[", "T", "]"}]}], ",", 
               RowBox[{"t", "\[Rule]", 
                RowBox[{"t", "[", "T", "]"}]}]}], "}"}]}], "/.", "params"}], 
           ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", "0", "]"}], "\[Equal]", "0.06"}], ",", 
         RowBox[{
          RowBox[{"t", "[", "0", "]"}], "\[Equal]", "3.5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "t"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "0", ",", "50"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol3", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p", "'"}], "[", "T", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dp", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p", "\[Rule]", 
                RowBox[{"p", "[", "T", "]"}]}], ",", 
               RowBox[{"t", "\[Rule]", 
                RowBox[{"t", "[", "T", "]"}]}]}], "}"}]}], "/.", "params"}], 
           ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"t", "'"}], "[", "T", "]"}], "\[Equal]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dt", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p", "\[Rule]", 
                RowBox[{"p", "[", "T", "]"}]}], ",", 
               RowBox[{"t", "\[Rule]", 
                RowBox[{"t", "[", "T", "]"}]}]}], "}"}]}], "/.", "params"}], 
           ")"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", "0", "]"}], "\[Equal]", "0.025"}], ",", 
         RowBox[{
          RowBox[{"t", "[", "0", "]"}], "\[Equal]", "2.5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "t"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "0", ",", "50"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Plotting", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"VectorPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dp", "/.", "params"}], ",", 
         RowBox[{"dt", "/.", "params"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "1"}], ",", "7"}], "}"}], ",", 
       RowBox[{"VectorScale", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0.015", ",", "0.5", ",", "None"}], "}"}]}], ",", 
       RowBox[{"VectorStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"GrayLevel", "[", "0.8", "]"}], "}"}]}], ",", 
       RowBox[{"VectorPoints", "\[Rule]", "30"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"tisocline", "/.", "params"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "0", ",", "5", ",", "0.001"}], "}"}]}], "]"}], 
       ",", 
