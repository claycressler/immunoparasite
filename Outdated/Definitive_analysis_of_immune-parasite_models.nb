Cell["\<\
Stability requires a negative trace and a positive determinant. Note that at \
a Th1-biased equilibrium (where Th2 = 0), you have \[Rho]2 = i2[Th1] (and \
vice versa). \
\>", "Text",
 CellChangeTimes->{{3.796645092932757*^9, 3.796645094789154*^9}, {
   3.7966463199968987`*^9, 3.7966464003784227`*^9}, 3.796646441567182*^9, {
   3.796655160688979*^9, 3.7966551694516287`*^9}, {3.7966552152502747`*^9, 
   3.79665523715456*^9}, {3.796655984572898*^9, 
   3.796656019289959*^9}},ExpressionUUID->"6e7a4f2f-7ae5-4912-b078-\
9293faa37f5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"J", "/.", 
     RowBox[{"Th2", "\[Rule]", "0"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s2", "[", "0", "]"}], "\[Rule]", "0"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"<", " ", "0"}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", 
   RowBox[{
    RowBox[{"J", "/.", 
     RowBox[{"Th2", "\[Rule]", "0"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s2", "[", "0", "]"}], "\[Rule]", "0"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{">", " ", "0"}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{
     RowBox[{"J", "/.", 
      RowBox[{"Th2", "\[Rule]", "0"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s2", "[", "0", "]"}], "\[Rule]", "0"}], "}"}]}], "]"}], 
   "\[Equal]", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "m"}], " ", 
     RowBox[{"(", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"J", "/.", 
         RowBox[{"Th2", "\[Rule]", "0"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"s2", "[", "0", "]"}], "\[Rule]", "0"}], "}"}]}], "]"}], 
      " ", ")"}]}], "-", 
    RowBox[{
     RowBox[{
      SuperscriptBox["i1", "\[Prime]",
       MultilineFunction->None], "[", "0", "]"}], " ", 
     RowBox[{
      SuperscriptBox["i2", "\[Prime]",
       MultilineFunction->None], "[", "Th1", "]"}]}], "-", 
    SuperscriptBox["m", "2"]}]}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.796646447291748*^9, 3.796646536086899*^9}, {
   3.796656024860482*^9, 3.796656043432522*^9}, 3.79665618242761*^9, {
   3.796656239398004*^9, 3.7966562593433533`*^9}, 3.796656607514496*^9},
 CellLabel->
  "In[853]:=",ExpressionUUID->"e35bcd42-56e8-4c17-8c82-863382445880"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], " ", "m"}], "+", 
  RowBox[{"s1", "[", "Th1", "]"}], "+", 
  RowBox[{"Th1", " ", 
   RowBox[{
    SuperscriptBox["s1", "\[Prime]",
     MultilineFunction->None], "[", "Th1", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.7966464522401047`*^9, 3.796646470038962*^9}, {
   3.796646505665756*^9, 3.796646536557706*^9}, 3.796646816992119*^9, 
   3.796655197580675*^9, {3.796656020489882*^9, 3.7966560438688107`*^9}, {
