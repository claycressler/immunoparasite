Cell["\<\
You can see that there are multiple equilibria here, but only one that is \
stable (a low activation equilibrium). Otherwise what happens is runaway \
stimulation. The positive self-promotion overwhelms cross-inhibition and the \
system is either stable at a low co-expression equilibrium, or it blows up. \
That is clearly infeasible.\
\>", "Text",
 CellChangeTimes->{{3.79727217560719*^9, 
  3.797272261478284*^9}},ExpressionUUID->"aae0e0dd-c1e9-459e-b0ab-\
9388b3e5ca63"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Beta]1", "\[Rule]", "0.05"}], ",", 
     RowBox[{"\[Beta]2", "\[Rule]", "0.05"}], ",", 
     RowBox[{"\[Iota]12", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Iota]21", "\[Rule]", "1"}], ",", 
     RowBox[{"\[Sigma]1", "\[Rule]", "2"}], ",", 
     RowBox[{"\[Sigma]2", "\[Rule]", "2"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realEq", "=", 
   RowBox[{"eq", "\[LeftDoubleBracket]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
