Cell[CellGroupData[{

Cell["Can you get similar behavior with a simpler model?", "Subsubsection",
 CellChangeTimes->{{3.796731557885154*^9, 3.796731559763797*^9}, {
  3.797248224985718*^9, 3.797248227201269*^9}, {3.797259545264304*^9, 
  3.797259552384625*^9}},ExpressionUUID->"22aedc12-49ef-46b3-b43a-\
ad4a4770f568"],

Cell["\<\
The only difference here is the Hill function with an exponent of 1 for \
self-stimulation, which is also supported by previous analyses - in \
particular, transcription factor promotion of cytokine expression is smooth, \
rather than switch-like. \
\>", "Text",
 CellChangeTimes->{{3.7972482314423923`*^9, 3.797248304297756*^9}, {
  3.7972483472619953`*^9, 3.797248432401791*^9}, {3.79724887715899*^9, 
  3.797248991280682*^9}, {3.797259557042265*^9, 
  3.797259616498551*^9}},ExpressionUUID->"e040cfb8-5d85-4546-9c6f-\
fb75cfc9f5fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dTh1", "=", 
   RowBox[{"b1", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s1", " ", "Th1"}], 
      RowBox[{"S1", "+", "Th1"}]], " ", 
     FractionBox[
      RowBox[{"I12", " "}], 
      RowBox[{"I12", "+", "Th2"}]]}], " ", "-", 
    RowBox[{"m", " ", "Th1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dTh2", "=", 
   RowBox[{"b2", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"s2", " ", "Th2"}], 
      RowBox[{"S2", "+", "Th2"}]], " ", 
     FractionBox[
      RowBox[{"I21", " "}], 
      RowBox[{"I21", "+", "Th1"}]]}], "-", 
    RowBox[{"m", " ", "Th2"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.796731586071199*^9, 3.796731630200124*^9}, {
   3.796741122839666*^9, 3.796741132927824*^9}, {3.796743393254848*^9, 
   3.796743396792616*^9}, {3.796743653283901*^9, 3.7967437158052197`*^9}, {
   3.796743756847563*^9, 3.796743860610216*^9}, {3.796743942015568*^9, 
   3.7967439537154293`*^9}, {3.796743996586073*^9, 3.796744008699789*^9}, {
   3.796744045556903*^9, 3.796744196261994*^9}, 3.796745669104089*^9, {
   3.7972489955375443`*^9, 3.797248997266801*^9}, {3.7972595831340733`*^9, 
   3.797259587295039*^9}, {3.7972596195701227`*^9, 3.797259625320241*^9}, {
   3.7972733424827223`*^9, 3.7972733440342503`*^9}},
 CellLabel->
  "In[2965]:=",ExpressionUUID->"0ab27bfd-b4c6-4180-9204-88f6e2a7ee5c"],

Cell["\<\
This model can be nondimensionalized identically to the previous model.\
\>", "Text",
 CellChangeTimes->{{3.797248999245418*^9, 3.7972490112945347`*^9}, {
  3.7972597581591*^9, 3.797259758519046*^9}, {3.797259929531125*^9, 
  3.797259942422817*^9}},ExpressionUUID->"64269074-4f2e-4cd0-9a13-\
a4adae65eec1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"dth1", "=", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["that", "TH1hat"], 
         RowBox[{"(", 
          RowBox[{"dTh1", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Th1", "\[Rule]", 
              RowBox[{"TH1hat", " ", "th1"}]}], ",", 
             RowBox[{"Th2", "\[Rule]", 
              RowBox[{"TH2hat", " ", "th2"}]}]}], "}"}]}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TH1hat", "\[Rule]", "S1"}], ",", 
          RowBox[{"TH2hat", "\[Rule]", "S2"}], ",", 
          RowBox[{"that", "\[Rule]", 
           RowBox[{"1", "/", "m"}]}]}], "}"}]}], "/.", 
       RowBox[{"b1", "\[Rule]", 
        RowBox[{"\[Beta]1", " ", "m", " ", "S1"}]}]}], "/.", 
      RowBox[{"s1", "\[Rule]", 
       RowBox[{"\[Sigma]1", " ", "m", " ", "S1"}]}]}], "/.", 
     RowBox[{"I12", "\[Rule]", 
      RowBox[{"\[Iota]12", " ", "S2"}]}]}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"dth2", "=", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["that", "TH2hat"], 
         RowBox[{"(", 
          RowBox[{"dTh2", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Th1", "\[Rule]", 
              RowBox[{"TH1hat", " ", "th1"}]}], ",", 
             RowBox[{"Th2", "\[Rule]", 
              RowBox[{"TH2hat", " ", "th2"}]}]}], "}"}]}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TH1hat", "\[Rule]", "S1"}], ",", 
          RowBox[{"TH2hat", "\[Rule]", "S2"}], ",", 
          RowBox[{"that", "\[Rule]", 
           RowBox[{"1", "/", "m"}]}]}], "}"}]}], "/.", 
       RowBox[{"b2", "\[Rule]", 
        RowBox[{"\[Beta]2", " ", "m", " ", "S2"}]}]}], "/.", 
      RowBox[{"s2", "\[Rule]", 
       RowBox[{"\[Sigma]2", " ", "m", " ", "S2"}]}]}], "/.", 
     RowBox[{"I21", "\[Rule]", 
      RowBox[{"\[Iota]21", " ", "S1"}]}]}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.7972733591743402`*^9, 3.7972733667491827`*^9}, {
  3.797273405723096*^9, 3.79727344060144*^9}, {3.7973333301606493`*^9, 
  3.797333392651814*^9}},
 CellLabel->
  "In[2975]:=",ExpressionUUID->"b52b3cbb-3298-42f3-a25a-42e3d6710d6b"],

Cell[BoxData[
 RowBox[{"\[Beta]1", "+", 
  RowBox[{"th1", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox[
      RowBox[{"\[Iota]12", " ", "\[Sigma]1"}], 
      RowBox[{"th2", "+", 
       RowBox[{"th1", " ", "th2"}], "+", "\[Iota]12", "+", 
       RowBox[{"th1", " ", "\[Iota]12"}]}]]}], ")"}]}]}]], "Output",
 CellChangeTimes->{
  3.796731633236829*^9, {3.796741127137891*^9, 3.796741133455064*^9}, 
   3.796743393725812*^9, 3.796743660274767*^9, {3.7967437108602667`*^9, 
   3.7967437188234167`*^9}, {3.79674376848081*^9, 3.796743861906639*^9}, 
   3.796743954481647*^9, {3.796744003532929*^9, 3.796744009086513*^9}, {
   3.7967440535850286`*^9, 3.7967440639761868`*^9}, {3.796744121136593*^9, 
   3.7967441968991947`*^9}, 3.796745743843115*^9, 3.797249016821039*^9, 
   3.79725974643023*^9, 3.797265403420609*^9, 3.7972733598850317`*^9, {
   3.797273424248075*^9, 3.7972734409960423`*^9}, {3.79733334812542*^9, 
   3.7973333928967867`*^9}},
 CellLabel->
  "Out[2975]=",ExpressionUUID->"e5038628-ad01-47a4-b2eb-422124239aa8"],

Cell[BoxData[
 RowBox[{"\[Beta]2", "+", 
  RowBox[{"th2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox[
      RowBox[{"\[Iota]21", " ", "\[Sigma]2"}], 
      RowBox[{"th1", "+", 
       RowBox[{"th1", " ", "th2"}], "+", "\[Iota]21", "+", 
       RowBox[{"th2", " ", "\[Iota]21"}]}]]}], ")"}]}]}]], "Output",
 CellChangeTimes->{
  3.796731633236829*^9, {3.796741127137891*^9, 3.796741133455064*^9}, 
   3.796743393725812*^9, 3.796743660274767*^9, {3.7967437108602667`*^9, 
   3.7967437188234167`*^9}, {3.79674376848081*^9, 3.796743861906639*^9}, 
   3.796743954481647*^9, {3.796744003532929*^9, 3.796744009086513*^9}, {
   3.7967440535850286`*^9, 3.7967440639761868`*^9}, {3.796744121136593*^9, 
   3.7967441968991947`*^9}, 3.796745743843115*^9, 3.797249016821039*^9, 
   3.79725974643023*^9, 3.797265403420609*^9, 3.7972733598850317`*^9, {
   3.797273424248075*^9, 3.7972734409960423`*^9}, {3.79733334812542*^9, 
   3.797333392903883*^9}},
 CellLabel->
  "Out[2976]=",ExpressionUUID->"99f87942-43da-49c5-b506-966b82145218"]
}, Open  ]],

Cell[TextData[{
 "This is more interpretable. For simplicity, let\[CloseCurlyQuote]s assume \
that the parameters are balanced between the Th cell populations, so there is \
no intrinsic bias towards either a Th1 or Th2 response. \n\nThe parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "i"], "=", 
    FractionBox[
     SubscriptBox["b", "i"], 
     RowBox[{"m", " ", 
      SubscriptBox["S", "i"]}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "4f27de5a-e709-42fa-a3cc-019efee6ba61"],
 " is the baseline immune supply rate divided by the rate that immune cells \
are depleted when at half the density that promotes maximal immune \
proliferation. The parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "i"], "=", 
    FractionBox[
     SubscriptBox["s", "i"], 
     RowBox[{"m", " ", 
      SubscriptBox["S", "i"]}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b9ea44d7-716f-47a2-b448-2c9249b580df"],
 " is the maximum immune proliferation rate divided by the same rate. Thus, \
rather than worrying excessively about the absolute values of these \
parameters, the more important thing is their relative value, with needing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "i"], ">>", 
    SubscriptBox["\[Beta]", "i"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "51256c43-03b0-4fde-843b-5a85b12e5f0f"],
 " since self-stimulated immune proliferation should be much higher than \
baseline immune supply. \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Iota]", "ij"], "=", 
    RowBox[{
     SubscriptBox["S", "i"], "/", 
     SubscriptBox["I", "ji"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "2ad4249b-f350-4fe8-ba64-f880ccbe6400"],
 " gives the ratio of the half-maxima for self-stimulated proliferation by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8f08d236-4f6b-47c7-afc6-14ba8b1daaf5"],
 " to cross-inhibition by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "099a0623-d44e-4d80-b52b-ddbc825b87a0"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Th", "j"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d401159a-14c9-483d-b17e-be7aba596172"],
 ". This should also presumably be less than 1, reflecting that \
self-promotion is greater than cross-inhibition.\n\nThe form of the isoclines \
can give good insight into the possible dynamics of the system. "
}], "Text",
 CellChangeTimes->{{3.796744863204067*^9, 3.796744982566412*^9}, {
  3.796745116228772*^9, 3.796745346538913*^9}, {3.79674541748205*^9, 
  3.796745450218279*^9}, {3.796745510845975*^9, 3.79674561760711*^9}, {
  3.796745649670163*^9, 3.796745657522422*^9}, {3.796745747140841*^9, 
  3.796745854712924*^9}, {3.797249021578272*^9, 3.7972491393330517`*^9}, {
  3.7972492789674473`*^9, 3.797249283500963*^9}, {3.7972493900493*^9, 
  3.797249453029727*^9}, {3.797273662561166*^9, 
  3.797273665764194*^9}},ExpressionUUID->"3d58e6b0-107c-4d0b-93b0-\
0056a6cb0ac1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"th1isocline", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"dth1", "\[Equal]", "0"}], ",", "th2"}], "]"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"th2isocline", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"dth2", "\[Equal]", "0"}], ",", "th1"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.796751461652462*^9, 3.796751462216481*^9}, {
  3.797273741781426*^9, 3.797273742971243*^9}},
 CellLabel->
  "In[2977]:=",ExpressionUUID->"2e488724-8687-44e0-9e2f-42148cc34e7c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"th2", "\[Rule]", 
    FractionBox[
     RowBox[{"\[Iota]12", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["th1", "2"]}], "+", "\[Beta]1", "+", 
        RowBox[{"th1", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Beta]1", "+", "\[Sigma]1"}], ")"}]}]}],
        ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "th1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"th1", "-", "\[Beta]1"}], ")"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.796751458708185*^9, 3.797259966933689*^9, 
  3.797265407657076*^9, 3.7972736704681673`*^9, 3.797273743353459*^9, 
  3.7973334073868237`*^9},
 CellLabel->
  "Out[2977]=",ExpressionUUID->"f8dd4ba6-fb9d-4ffb-b312-4117d305014a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"th1", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "th2"}], " ", "\[Iota]21"}], "-", 
      RowBox[{
       SuperscriptBox["th2", "2"], " ", "\[Iota]21"}], "+", 
      RowBox[{"\[Beta]2", " ", "\[Iota]21"}], "+", 
      RowBox[{"th2", " ", "\[Beta]2", " ", "\[Iota]21"}], "+", 
      RowBox[{"th2", " ", "\[Iota]21", " ", "\[Sigma]2"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "th2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"th2", "-", "\[Beta]2"}], ")"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.796751458708185*^9, 3.797259966933689*^9, 
  3.797265407657076*^9, 3.7972736704681673`*^9, 3.797273743353459*^9, 
  3.7973334073953733`*^9},
 CellLabel->
  "Out[2978]=",ExpressionUUID->"e9c04051-d4be-45ed-b605-a1eaad06afe1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["th1", "2"]}], "+", "\[Beta]1", "+", 
    RowBox[{"th1", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Beta]1", "+", "\[Sigma]1"}], ")"}]}]}], "/.", 
   RowBox[{"th1", "\[Rule]", "\[Beta]1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7972743582578897`*^9, 3.797274369733054*^9}},
 CellLabel->
  "In[2286]:=",ExpressionUUID->"fab18603-0eee-4ab9-8a4c-a2d4426065e7"],

Cell[BoxData[
 RowBox[{"\[Beta]1", " ", "\[Sigma]1"}]], "Output",
 CellChangeTimes->{{3.7972743645172997`*^9, 3.797274370255287*^9}},
 CellLabel->
  "Out[2286]=",ExpressionUUID->"2dcddef0-e22d-4a56-8842-79d0cbf5b708"]
}, Open  ]],

Cell[TextData[{
 "Note that the lines th1=0 and th2=0 are ",
 StyleBox["not",
  FontSlant->"Italic"],
 " isoclines for this system because of baseline Th cell-independent \
proliferation.  This is important because it means that only the \
intersections of the two lines above are possible equilibria of the system. \
In order to have multi-stability, the isoclines must cross at multiple \
places. This will be most easily facilitated by the slope of the isoclines \
changing signs.\n\nTaking the derivatives of the isoclines with respect to \
the Th cell populations, you can see that, with this model, the slopes of the \
isoclines are both ",
 StyleBox["always ",
  FontSlant->"Italic"],
 "negative, regardless of any other parameter value. This means that any \
potential for multistability will be pretty blunted."
}], "Text",
 CellChangeTimes->{{3.797249302377695*^9, 3.7972493705189943`*^9}, {
   3.797249454672964*^9, 3.797249573660658*^9}, {3.797249624737336*^9, 
   3.797249683719603*^9}, {3.797249718741274*^9, 3.7972498274161167`*^9}, 
   3.7972499895292997`*^9, {3.797259990764681*^9, 3.797260038576991*^9}, {
   3.797260102724888*^9, 3.797260109677071*^9}, {3.7972604057221813`*^9, 
   3.7972604942238626`*^9}, {3.7972645922293577`*^9, 
   3.797264594378088*^9}},ExpressionUUID->"bfba7dcd-901d-455b-b7c0-\
a4f563a0b820"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"th1isocline", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", "th1"}], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"th2isocline", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", "th2"}], "]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.797249784835318*^9, 3.797249788279293*^9}},
 CellLabel->
  "In[2979]:=",ExpressionUUID->"b1541e62-54e6-4804-ae89-28b5abc36fab"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["th1", "2"], "+", "\[Beta]1"}], ")"}], " ", "\[Iota]12", 
    " ", "\[Sigma]1"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "th1"}], ")"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th1", "-", "\[Beta]1"}], ")"}], "2"]}]]}]], "Output",
 CellChangeTimes->{3.797249789506987*^9, 3.79725997989115*^9, 
  3.7972740631053*^9, 3.797333446756791*^9},
 CellLabel->
  "Out[2979]=",ExpressionUUID->"afafe010-a15d-4e23-bc2d-b05a8e9ede8a"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["th2", "2"], "+", "\[Beta]2"}], ")"}], " ", "\[Iota]21", 
    " ", "\[Sigma]2"}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "th2"}], ")"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"th2", "-", "\[Beta]2"}], ")"}], "2"]}]]}]], "Output",
 CellChangeTimes->{3.797249789506987*^9, 3.79725997989115*^9, 
  3.7972740631053*^9, 3.7973334467650337`*^9},
 CellLabel->
  "Out[2980]=",ExpressionUUID->"a41966f5-6619-4471-b6ab-5d13611a6293"]
}, Open  ]],

Cell[TextData[{
 "To evaluate the potential for multiple intersections, we need to have a \
clearer sense of the shape by looking at the second derivative. If the sign \
of the second derivative also remains constant, then the function will, \
overall, have a simple shape, and there will essentially be no possibility of \
multistability.\n\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["th", "i"], ">", 
    SubscriptBox["\[Beta]", "i"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9199bac4-04e7-49c9-aed4-c22dae7d0dad"],
 ", the second derivative will be positive. Thus both isoclines have a simple \
shape: a function with a negative slope but a positive second derivative has \
a shape like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "x"}]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6811309a-5fb5-4d9f-8d55-fa4fe8c71ace"],
 ". Two such curves will only ever be able to intersect in one place. Thus \
there is no possibility for multistability in this model."
}], "Text",
 CellChangeTimes->{{3.797265450515923*^9, 
  3.797265750014268*^9}},ExpressionUUID->"27cdd8cf-3fc1-43b5-bb98-\
681db013c743"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"-", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.797265706028824*^9, 3.7972657125066338`*^9}},
 CellLabel->
  "In[2143]:=",ExpressionUUID->"96843e33-7972-477e-9fcb-605293b94a67"],

