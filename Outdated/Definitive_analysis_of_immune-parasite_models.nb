  "In[832]:=",ExpressionUUID->"aaf92269-dbaa-4b03-a465-d21f5f59568e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "m"}], "+", 
      RowBox[{"s1", "[", "Th1", "]"}], "+", 
      RowBox[{"Th1", " ", 
       RowBox[{
        SuperscriptBox["s1", "\[Prime]",
         MultilineFunction->None], "[", "Th1", "]"}]}]}], ",", 
     RowBox[{"-", 
      RowBox[{
       SuperscriptBox["i1", "\[Prime]",
        MultilineFunction->None], "[", "Th2", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
