Cell[TextData[{
 "However, if you greatly weaken cross-inhibition (in this case by reducing \
the value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Iota]", "ij"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e3b5b272-c3b6-400c-bc87-3f8a5e0ab58b"],
 ", then you can end up with a single stable co-expression equilibrium."
}], "Text",
 CellChangeTimes->{{3.797265018436019*^9, 3.797265094936417*^9}, {
  3.797337495114156*^9, 
  3.797337511346614*^9}},ExpressionUUID->"f42b3154-3ee8-4d96-bc9d-\
c3e734afde0a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Sigma]1", "\[Rule]", "3.5"}], ",", 
     RowBox[{"\[Sigma]2", "\[Rule]", "3.5"}], ",", 
     RowBox[{"\[Beta]1", "\[Rule]", "0.05`"}], ",", 
     RowBox[{"\[Beta]2", "\[Rule]", "0.05`"}], ",", 
     RowBox[{"\[Iota]12", "\[Rule]", "3"}], ",", 
     RowBox[{"\[Iota]21", "\[Rule]", "3"}]}], "}"}]}], ";", 
  RowBox[{"eq", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dth1", "\[Equal]", "0"}], ",", 
         RowBox[{"dth2", "\[Equal]", "0"}]}], "}"}], "/.", "params"}], ",", 
      RowBox[{"{", 
       RowBox[{"th1", ",", "th2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realEq", "=", 
   RowBox[{"eq", "\[LeftDoubleBracket]", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "1", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"eq", "\[LeftDoubleBracket]", 
          RowBox[{";;", ",", "2", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
         
         RowBox[{"x_", "/;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", "x", "]"}], "]"}], "<", 
             SuperscriptBox["10", 
              RowBox[{"-", "6"}]]}], "&&", 
            RowBox[{
             RowBox[{"Re", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], "]"}]}], 
      "]"}], "]"}], "\[RightDoubleBracket]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "stable", " ", "equilibria", " ", "have", " ", "a", " ", "positive", " ", 
    "determinant", " ", "and", " ", "a", " ", "negative", " ", "trace"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableInds", "=", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dth1", ",", "dth2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"th1", ",", "th2"}], "}"}], "}"}]}], "]"}], "]"}], "/.",
           "params"}], "/.", "realEq"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", "<", "0"}]}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"unstableInds", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "realEq", "]"}]}], "}"}]}], "]"}], ",", 
     "stableInds"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"th1", ",", 
         RowBox[{
          RowBox[{"th1isocline", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "/.", 
          "params"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"th1", ",", "0", ",", "4", ",", "0.001"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "3"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Orange"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Th1 isocline\>\"", ",", "\"\<Th2 isocline\>\""}], 
         "}"}]}], "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"th2isocline", "\[LeftDoubleBracket]", 
           RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}], "/.", 
          "params"}], ",", "th2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"th2", ",", "0", ",", "4", ",", "0.001"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Orange"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"realEq", "\[LeftDoubleBracket]", 
      RowBox[{"stableInds", ",", ";;", ",", "2"}], "\[RightDoubleBracket]"}], 
     ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"realEq", "\[LeftDoubleBracket]", 
      RowBox[{"unstableInds", ",", ";;", ",", "2"}], 
      "\[RightDoubleBracket]"}], ",", 
     RowBox[{"PlotMarkers", "\[Rule]", "\"\<OpenMarkers\>\""}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", "Black", "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"VectorPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dth1", "/.", "params"}], ",", 
       RowBox[{"dth2", "/.", "params"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"th1", ",", 
       RowBox[{"-", "1"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"th2", ",", 
       RowBox[{"-", "1"}], ",", "3"}], "}"}], ",", 
     RowBox[{"VectorScale", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0.025", ",", "0.9", ",", "None"}], "}"}]}], ",", 
     RowBox[{"VectorColorFunction", "\[Rule]", "None"}], ",", " ", 
     RowBox[{"VectorStyle", "\[Rule]", 
      RowBox[{"Gray", "[", "0.8", "]"}]}], ",", 
     RowBox[{"VectorPoints", "\[Rule]", "30"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Th1\>\"", ",", "\"\<Th2\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.797264972392024*^9, 3.7972649977156143`*^9}, {
