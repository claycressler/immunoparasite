       SuperscriptBox["\[Iota]21", "2"], " ", "\[Sigma]2"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "th2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["th1", "2"], "+", 
         SuperscriptBox["\[Iota]21", "2"]}], ")"}]}]]}], ")"}]}]}]], "Output",\

 CellChangeTimes->{{3.797260618724176*^9, 3.797260629103874*^9}, {
