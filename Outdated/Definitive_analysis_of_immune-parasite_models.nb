cfe6eba698a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"J", "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dTh1", ",", "dTh2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Th1", ",", "Th2"}], "}"}], "}"}]}], "]"}]}]], "Input",
