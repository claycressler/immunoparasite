Cell[BoxData[{
 RowBox[{
  RowBox[{"ESS1", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pp", ",", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["vm", "4"]}], "+", 
               RowBox[{"2", " ", 
                SuperscriptBox["vm", "3"], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "\[Gamma]"}], 
                  "-", "\[Mu]"}], ")"}]}], "+", 
               RowBox[{"2", " ", "h", " ", "vm", " ", "\[Mu]", " ", 
                RowBox[{"(", 
                 RowBox[{"\[Gamma]", "+", "\[Mu]"}], ")"}]}], "-", 
               RowBox[{"h", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "\[Gamma]"}], 
                  "-", "\[Mu]"}], ")"}], " ", "\[Mu]", " ", 
                RowBox[{"(", 
                 RowBox[{"\[Gamma]", "+", "\[Mu]"}], ")"}]}], "+", 
               RowBox[{
                SuperscriptBox["vm", "2"], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", 
                   SuperscriptBox["\[Gamma]", "2"]}], "+", 
                  RowBox[{"2", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "\[Gamma]", " ",
                    "\[Mu]"}], "-", 
                  SuperscriptBox["\[Mu]", "2"], "+", 
                  RowBox[{"h", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"p", " ", "\[Gamma]"}], "+", "\[Mu]"}], ")"}]}]}],
                  ")"}]}]}], ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"h", "->", "0.01"}], ",", 
               RowBox[{"\[Mu]", "->", 
                RowBox[{"1", "/", 
                 RowBox[{"(", 
                  RowBox[{"75", "*", "365"}], ")"}]}]}], ",", 
               RowBox[{"\[Gamma]", "->", "pp"}], ",", 
               RowBox[{"p", "->", "1"}]}], "}"}]}], ")"}], "==", "0"}], ",", 
          "vm"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", "1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
